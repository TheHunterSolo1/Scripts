Test("hookmetamethod", function()
    if not IsFunction(hookmetamethod) then error("hookmetamethod is not a function") end
    local called = false
    local original
    local ok = pcall(function()
        original = hookmetamethod(game, "__index", function(self, key)
            if key == "__CompatHookTest__" then
                called = true
                return true
            end
            return original(self, key)
        end)
    end)
    if not ok then error("hookmetamethod hook failed to attach") end
    if not original then error("hookmetamethod did not return original") end
    local _ = game.__CompatHookTest__
    pcall(function() hookmetamethod(game, "__index", original) end)
    if not called then error("hookmetamethod hook was not triggered") end
    return true
end)

