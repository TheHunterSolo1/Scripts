local Support = {}
local Errors = {}
local LP = game:GetService("Players").LocalPlayer
repeat task.wait() until LP.Character

local function IsFunc(v) return type(v) == "function" end
local function IsTbl(v) return type(v) == "table" end
local function IsStr(v) return type(v) == "string" end

local function GetExec()
    if IsFunc(identifyexecutor) and IsStr(identifyexecutor()) then return identifyexecutor() end
    if IsFunc(getexecutorname) and IsStr(getexecutorname()) then return getexecutorname() end
    return "Unknown"
end

local function Run(id, fn)
    local ok, res = pcall(fn)
    if not ok then
        Support[id] = "red"
        Errors[id] = tostring(res):sub(1, 80)
        print("🔴 " .. id)
    elseif res == true then
        Support[id] = "green"
        print("🟢 " .. id)
    else
        Support[id] = "yellow"
        Errors[id] = "Exists but non-functional"
        print("🟡 " .. id)
    end
end

