Test("firetouchinterest", function()
    if not IsFunction(firetouchinterest) then return false end
    local touched = false
    local partA = Instance.new("Part")
    local partB = Instance.new("Part")
    partA.Anchored = true
    partB.Anchored = true
    partA.Transparency = 1
    partB.Transparency = 1
    partA.Size = Vector3.new(4, 4, 4)
    partB.Size = Vector3.new(4, 4, 4)
    partA.Position = Vector3.new(0, 100, 0)
    partB.Position = Vector3.new(0, 104, 0)
    partA.Parent = workspace
    partB.Parent = workspace
    local conn = partA.Touched:Connect(function(hit)
        if hit == partB then
            touched = true
        end
    end)
    pcall(function()
        firetouchinterest(partA, partB, 0)
        firetouchinterest(partA, partB, 1)
    end)
    task.wait(0.2)
    conn:Disconnect()
    partA:Destroy()
    partB:Destroy()
    return touched and true or "noop"
end)

