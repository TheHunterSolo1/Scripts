Test("firetouchinterest", function()
    if not IsFunction(firetouchinterest) then error("firetouchinterest is not a function") end
    if not LocalPlayer.Character then error("Character not loaded") end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then error("HumanoidRootPart not found") end
    
    local touched = false
    local partA = Instance.new("Part")
    local partB = Instance.new("Part")
    partA.Anchored = true
    partB.Anchored = true 
    partA.Transparency = 1
    partB.Transparency = 1
    partA.CanCollide = false
    partB.CanCollide = false
    partA.Size = Vector3.new(4, 4, 4)
    partB.Size = Vector3.new(4, 4, 4)
    partA.Position = Vector3.new(0, 100, 0)
    partB.Position = partA.Position
    partA.Parent = workspace
    partB.Parent = workspace
    
    local conn = partA.Touched:Connect(function() touched = true end)
    
    local ok1 = pcall(function() firetouchinterest(LocalPlayer.Character.HumanoidRootPart, partA, 0) end)
    task.wait(0.2)
    local ok2 = pcall(function() firetouchinterest(LocalPlayer.Character.HumanoidRootPart, partA, 1) end)
    task.wait(0.5)
    
    conn:Disconnect()
    partA:Destroy()
    partB:Destroy()
    
    if not ok1 then error("firetouchinterest(0) pcall failed") end
    if not ok2 then error("firetouchinterest(1) pcall failed") end
    if not touched then error("firetouchinterest did not fire touch event") end
    return true
end)

