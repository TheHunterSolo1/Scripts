local Support = {}
local Workspace = cloneref and cloneref(game:GetService("Workspace")) or game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function IsFunction(v) return type(v) == "function" end
local function IsTable(v) return type(v) == "table" end
local function IsString(v) return type(v) == "string" end

local function GetExecutor()
    if IsFunction(identifyexecutor) then
        local name = identifyexecutor()
        if IsString(name) then return name end
    end
    if IsFunction(getexecutorname) then
        local name = getexecutorname()
        if IsString(name) then return name end
    end
    return "Unknown"
end

local ExecutorName = GetExecutor()

local function SafeRun(f, ...)
    local ok, res = pcall(f, ...)
    return ok, res
end

local function Test(id, f)
    local ok, res = SafeRun(f)
    Support[id] = ok and res == true
    local icon = Support[id] and "🟢" or "🔴"
    print(string.format("%s %s", icon, id))
    return Support[id]
end

print("[" .. ExecutorName .. "] Compatibility Check")

Test("identifyexecutor", function()
    return IsFunction(identifyexecutor) and IsString(identifyexecutor())
end)

Test("getexecutorname", function()
    return IsFunction(getexecutorname) and IsString(getexecutorname())
end)

Test("getgenv", function()
    if not IsFunction(getgenv) then return false end
    getgenv().CompatTest = true
    local ok = getgenv().CompatTest == true
    getgenv().CompatTest = nil
    return ok
end)

Test("gethui", function()
    if not IsFunction(gethui) then return false end
    local hui = gethui()
    return hui ~= nil and hui:IsA("Instance")
end)

Test("checkcaller", function()
    return IsFunction(checkcaller) and checkcaller() == true
end)

Test("hookmetamethod", function()
    if not IsFunction(hookmetamethod) then return false end
    local called = false
    local original
    local ok = pcall(function()
        original = hookmetamethod(game, "__index", function(self, key)
            if key == "__CompatHookTest__" then
                called = true
                return true
            end
            return original(self, key)
        end)
    end)
    if ok and original then
        local _ = game.__CompatHookTest__
        pcall(function() hookmetamethod(game, "__index", original) end)
    end
    return called
end)

Test("getreg", function()
    local f = getreg or getregistry
    if not IsFunction(f) then return false end
    local reg = f()
    return IsTable(reg) and #reg > 0
end)

Test("getgc", function()
    if not IsFunction(getgc) then return false end
    local gc = getgc()
    return IsTable(gc) and #gc > 0
end)

Test("Drawing.new", function()
    if not IsFunction(Drawing.new) then return false end
    local line = Drawing.new("Line")
    local ok = line ~= nil
    if ok then pcall(function() line:Destroy() end) end
    return ok
end)

Test("writefile", function()
    if not IsFunction(writefile) then return false end
    local ok = pcall(function() writefile("__compat_w.txt", "test") end)
    if ok and IsFunction(delfile) then pcall(delfile, "__compat_w.txt") end
    return ok
end)

Test("readfile", function()
    if not (IsFunction(readfile) and IsFunction(writefile)) then return false end
    pcall(function() writefile("__compat_r.txt", "test") end)
    local content = IsFunction(readfile) and readfile("__compat_r.txt")
    local ok = content == "test"
    if IsFunction(delfile) then pcall(delfile, "__compat_r.txt") end
    return ok
end)

Test("isnetworkowner", function()
    if not IsFunction(isnetworkowner) then return false end
    local part = Instance.new("Part")
    local ok = pcall(function() return isnetworkowner(part) end)
    part:Destroy()
    return ok
end)

Test("sethiddenproperty", function()
    if not IsFunction(sethiddenproperty) then return false end
    local part = Instance.new("Part")
    sethiddenproperty(part, "Massless", true)
    task.wait()
    local ok = part.Massless == true
    part:Destroy()
    return ok
end)

Test("gethiddenproperty", function()
    if not IsFunction(gethiddenproperty) then return false end
    local part = Instance.new("Part")
    if IsFunction(sethiddenproperty) then
        sethiddenproperty(part, "Massless", true)
    else
        part.Massless = true
    end
    task.wait()
    local val = gethiddenproperty(part, "Massless")
    local ok = val == true and part.Massless == true
    part:Destroy()
    return ok
end)

Test("getnilinstances", function()
    if not IsFunction(getnilinstances) then return false end
    local instances = getnilinstances()
    return IsTable(instances) and #instances > 0
end)

Test("replicatesignal", function()
    return IsFunction(replicatesignal)
end)

Test("require", function()
    if ExecutorName == "Xeno" or ExecutorName == "Seliware" then return false end
    if not IsFunction(require) then return false end
    local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local mod = scripts and scripts:FindFirstChild("PlayerModule")
    if not mod then return false end
    return pcall(require, mod)
end)

Test("fireproximityprompt", function()
    if not fireproximityprompt then return false end
    if ExecutorName == "Delta" then return false end
    local part = Instance.new("Part", workspace)
    part.Anchored = true
    local prompt = Instance.new("ProximityPrompt", part)
    local done = false
    local conn = prompt.Triggered:Connect(function() done = true end)
    fireproximityprompt(prompt)
    task.wait(0.5)
    conn:Disconnect()
    part:Destroy()
    return done
end)

Test("firetouchinterest", function()
    if not IsFunction(firetouchinterest) then return false end
    if ExecutorName == "Delta" then return false end
    local touched = false
    local partA = Instance.new("Part", Workspace)
    local partB = Instance.new("Part", Workspace)
    partA.Anchored = true
    partB.Anchored = true
    local conn = partA.Touched:Connect(function() touched = true end)
    firetouchinterest(partA, partB, 0)
    firetouchinterest(partA, partB, 1)
    task.wait(0.3)
    conn:Disconnect()
    partA:Destroy()
    partB:Destroy()
    return touched
end)

local passed = 0
local total = 0
for _, v in pairs(Support) do
    total = total + 1
    if v then passed = passed + 1 end
end

print(string.format("Results: %d/%d (%d%%)", passed, total, math.floor((passed / total) * 100)))

if IsFunction(getgenv) then getgenv().ExecutorSupport = Support end
return Support
