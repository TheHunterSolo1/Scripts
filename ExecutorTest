local function IsFunction(v) return type(v) == "function" end
local function IsTable(v) return type(v) == "table" end
local function IsString(v) return type(v) == "string" end

local function GetExecutor()
    if IsFunction(identifyexecutor) then
        local name = identifyexecutor()
        if IsString(name) then return name end
    end
    if IsFunction(getexecutorname) then
        local name = getexecutorname()
        if IsString(name) then return name end
    end
    return "Unknown"
end

local ExecutorName = GetExecutor()

local function Test(id, f)
    local globalExists = false
    local parts = {}
    for part in string.gmatch(id, "[^%.]+") do
        table.insert(parts, part)
    end
    
    local current = getgenv and getgenv() or _G
    local exists = true
    for _, part in ipairs(parts) do
        if type(current) == "table" and current[part] ~= nil then
            current = current[part]
        else
            exists = false
            break
        end
    end
    globalExists = exists and type(current) == "function"

    if not globalExists then
        Support[id] = {Status = "red", Message = id .. " -- function doesn't exist"}
        print(string.format("🔴 %s", Support[id].Message))
        return false
    end

    local success, res = pcall(f)
    local status = "red"
    local msg = ""
    
    if success then
        if res == true then
            status = "green"
            msg = id .. " -- passed"
        elseif res == "noop" then
            status = "yellow"
            msg = id .. " -- function exists but it doesn't do anything"
        else
            status = "red"
            msg = id .. " -- function returns nil or doesnt work"
        end
    else
        msg = id .. " -- function failed to execute (" .. tostring(res) .. ")"
    end
    
    Support[id] = {Status = status, Message = msg}
    local icon = status == "green" and "🟢" or (status == "yellow" and "🟡" or "🔴")
    print(string.format("%s %s", icon, msg))
    return status == "green"
end

