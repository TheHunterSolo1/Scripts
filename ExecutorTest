Run("firetouchinterest", function()
    if not IsFunc(firetouchinterest) then error("Not a function") end
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then error("No character") end
    
    local touched = false
    local pA = Instance.new("Part")
    local pB = Instance.new("Part")
    pA.Anchored = true
    pB.Anchored = true
    pA.Transparency = 1
    pB.Transparency = 1
    pA.CanCollide = false
    pB.CanCollide = false
    pA.Size = Vector3.new(4, 4, 4)
    pB.Size = Vector3.new(4, 4, 4)
    pA.Position = Vector3.new(0, 100, 0)
    pB.Position = pA.Position
    pA.Parent = WS
    pB.Parent = WS
    
    local c = pA.Touched:Connect(function() touched = true end)
    pcall(function() firetouchinterest(LP.Character.HumanoidRootPart, pA, 0) end)
    task.wait(0.15)
    pcall(function() firetouchinterest(LP.Character.HumanoidRootPart, pA, 1) end)
    task.wait(0.25)
    c:Disconnect()
    pA:Destroy()
    pB:Destroy()
    return touched
end)

