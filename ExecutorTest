local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function IsFunction(v) return type(v) == "function" end
local function IsTable(v) return type(v) == "table" end
local function IsString(v) return type(v) == "string" end

local function GetExecutor()
    if IsFunction(identifyexecutor) then
        local name = identifyexecutor()
        if IsString(name) then return name end
    end
    if IsFunction(getexecutorname) then
        local name = getexecutorname()
        if IsString(name) then return name end
    end
    return "Unknown"
end

local ExecutorName = GetExecutor()

local function SafeRun(f, ...)
    local ok, res = pcall(f, ...)
    return ok, res
end

local function Test(id, f)
    local ok, res = SafeRun(f)
    Support[id] = ok and res == true
    local icon = Support[id] and "🟢" or "🔴"
    print(string.format("%s %s", icon, id))
    return Support[id]
end

