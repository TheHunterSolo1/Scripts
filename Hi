-- ============================================================
-- HELPERS
-- ============================================================
local function getMyRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function getClosestPlayer()
    local myRoot = getMyRoot()
    if not myRoot then return nil, nil end

    local closestPlayer = nil
    local closestRoot   = nil
    local shortest      = math.huge

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer then
            local otherChar = otherPlayer.Character
            local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
            if otherRoot then
                local distance = (myRoot.Position - otherRoot.Position).Magnitude
                if distance < shortest then
                    shortest      = distance
                    closestPlayer = otherPlayer
                    closestRoot   = otherRoot
                end
            end
        end
    end

    return closestPlayer, closestRoot
end

-- ============================================================
-- HEARTBEAT LOOP
-- ============================================================
local isRunning = false
local heartbeatConnection = nil

local function heartbeatTick()
    local myRoot = getMyRoot()
    if not myRoot then return end

    local closestPlayer, closestRoot = getClosestPlayer()
    if not (closestPlayer and closestRoot) then
        status.Text = "No target"
        return
    end

    if type(sethiddenproperty) == "function" then
        pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", closestRoot)
    end

    myRoot.CFrame = CFrame.new(0, 0, 6)
    status.Text = "-> " .. closestPlayer.Name
end

local function start()
    if isRunning then return end
    isRunning = true
    heartbeatConnection = RunService.Heartbeat:Connect(heartbeatTick)
    toggleButton.Text = "Stop"
    toggleButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
end

local function stop()
    isRunning = false
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end
    toggleButton.Text = "Start"
    toggleButton.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
    status.Text = "Idle"
end

-- ============================================================
-- CONNECTIONS
-- ============================================================
toggleButton.MouseButton1Click:Connect(function()
    if isRunning then
        stop()
    else
        start()
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isRunning then
        stop()
    end
end)

