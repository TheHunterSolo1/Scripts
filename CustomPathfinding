getgenv().PathToLoop = function()
    if getgenv().PathfindingThread then task.cancel(getgenv().PathfindingThread) end

    getgenv().PathfindingThread = task.spawn(function()
        local PathfindingService = game:GetService("PathfindingService")
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        local Player = Players.LocalPlayer
        local Character = Player.Character or Player.CharacterAdded:Wait()
        local Root = Character:WaitForChild("HumanoidRootPart")
        local Humanoid = Character:WaitForChild("Humanoid")

        local Waypoints = {}
        local CurrentIndex = 0
        local LastPos = Root.Position
        local StuckTimer = 0

        local Path = PathfindingService:CreatePath({
            AgentRadius = 0.01,
            AgentHeight = 3.5,
            AgentCanJump = true,
            WaypointSpacing = 2
        })

        local function PathTo(Target)
            local success, _ = pcall(function()
                Path:ComputeAsync(Root.Position, Target)
            end)
            if success and Path.Status == Enum.PathStatus.Success then
                Waypoints = Path:GetWaypoints()
                CurrentIndex = 1
            else
                Humanoid:MoveTo(Target)
            end
        end

        task.spawn(function()
            while task.wait(0.3) do
                if not getgenv().PathfindingThread then break end
                local LatestRoom = ReplicatedStorage.GameData.LatestRoom.Value
                local Room = workspace.CurrentRooms:FindFirstChild(tostring(LatestRoom))
                if Room then
                    local HasKey = Character:FindFirstChild("Key") or Player.Backpack:FindFirstChild("Key")
                    local KeyObj = Room:FindFirstChild("KeyObtain", true)
                    local Goal = nil

                    if KeyObj and not HasKey then
                        Goal = (KeyObj:IsA("Model") and KeyObj.PrimaryPart or KeyObj).Position
                    elseif Room:FindFirstChild("Door") then
                        local Door = Room.Door:FindFirstChild("Door") or Room.Door:FindFirstChild("Hidden")
                        if Door then Goal = Door.Position end
                    end

                    if Goal then PathTo(Goal) end
                end
            end
        end)

        RunService.Heartbeat:Connect(function()
            if not getgenv().PathfindingThread then return end
            
            if Waypoints and CurrentIndex <= #Waypoints then
                local Point = Waypoints[CurrentIndex]
                Humanoid:MoveTo(Point.Position)

                if (Root.Position - LastPos).Magnitude < 0.1 then
                    StuckTimer = StuckTimer + task.wait()
                    if StuckTimer > 0.5 then
                        Humanoid.Jump = true
                        StuckTimer = 0
                        local Room = workspace.CurrentRooms:FindFirstChild(tostring(ReplicatedStorage.GameData.LatestRoom.Value))
                        if Room and Room:FindFirstChild("Door") then 
                            local D = Room.Door:FindFirstChild("Door") or Room.Door:FindFirstChild("Hidden")
                            if D then PathTo(D.Position) end
                        end
                    end
                else
                    StuckTimer = 0
                end
                LastPos = Root.Position

                if Point.Action == Enum.PathWaypointAction.Jump then Humanoid.Jump = true end
                if (Root.Position - Point.Position).Magnitude < 2.5 then
                    CurrentIndex = CurrentIndex + 1
                end
            end
        end)
    end)
end

PathToLoop()
