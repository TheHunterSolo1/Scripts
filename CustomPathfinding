getgenv().PathToLoop = function()
    if getgenv().PathfindingThread then
        task.cancel(getgenv().PathfindingThread)
    end

    getgenv().PathfindingThread = task.spawn(function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        
        local Player = Players.LocalPlayer
        local Character = Player.Character or Player.CharacterAdded:Wait()
        local Root = Character:WaitForChild("HumanoidRootPart")
        local Humanoid = Character:WaitForChild("Humanoid")

        local Visuals = workspace:FindFirstChild("BFSPath") or Instance.new("Folder", workspace)
        Visuals.Name = "BFSPath"

        local GridSize = 3.5
        local CurrentPath = {}
        local LastPosition = Root.Position
        local StuckTime = 0
        local TargetPos = nil

        local function CheckCollision(Start, End)
            local Params = RaycastParams.new()
            Params.FilterDescendantsInstances = {Character, Visuals}
            Params.FilterType = Enum.RaycastFilterType.Exclude
            local Direction = (End - Start)
            local Result = workspace:Blockcast(CFrame.new(Start + Vector3.new(0, 2.5, 0), End + Vector3.new(0, 2.5, 0)), Vector3.new(2.8, 4.5, 2.8), Direction, Params)
            return Result and Result.Instance and Result.Instance.CanCollide and Result.Instance.Transparency < 1
        end

        local function GetNeighbors(Pos)
            local Neighbors = {}
            local Dirs = {Vector3.new(GridSize,0,0), Vector3.new(-GridSize,0,0), Vector3.new(0,0,GridSize), Vector3.new(0,0,-GridSize)}
            for _, Dir in Dirs do
                local NP = Pos + Dir
                local Floor = workspace:Raycast(NP + Vector3.new(0, 5, 0), Vector3.new(0, -10, 0))
                if Floor and not CheckCollision(Pos, Floor.Position) then
                    table.insert(Neighbors, Floor.Position)
                end
            end
            return Neighbors
        end

        local function ToKey(V) return math.round(V.X/1.5)..","..math.round(V.Y/1.5)..","..math.round(V.Z/1.5) end

        local function SolveBFS(Start, Goal)
            local Queue = {Start}
            local CameFrom = {[ToKey(Start)] = "None"}
            local Found = nil

            while #Queue > 0 do
                local Current = table.remove(Queue, 1)
                if (Current - Goal).Magnitude < GridSize * 1.5 then
                    Found = Current
                    break
                end

                for _, Next in GetNeighbors(Current) do
                    local Key = ToKey(Next)
                    if not CameFrom[Key] then
                        CameFrom[Key] = Current
                        table.insert(Queue, Next)
                    end
                end
                if #Queue > 400 then break end
            end

            if Found then
                local Path = {}
                local Curr = Found
                while Curr ~= "None" do
                    table.insert(Path, 1, Curr)
                    Curr = CameFrom[ToKey(Curr)]
                end
                return Path
            end
            return nil
        end

        task.spawn(function()
            while task.wait(0.5) do
                if not getgenv().PathfindingThread then break end
                local LatestRoom = ReplicatedStorage.GameData.LatestRoom.Value
                local Room = workspace.CurrentRooms:FindFirstChild(tostring(LatestRoom))
                if Room then
                    local HasKey = Character:FindFirstChild("Key") or Player.Backpack:FindFirstChild("Key")
                    local KeyObj = Room:FindFirstChild("KeyObtain", true)
                    local Goal = nil
                    if KeyObj and not HasKey then
                        Goal = (KeyObj:IsA("Model") and KeyObj.PrimaryPart or KeyObj).Position
                    elseif Room:FindFirstChild("Door") then
                        local D = Room.Door:FindFirstChild("Door") or Room.Door:FindFirstChild("Hidden")
                        if D then Goal = D.Position end
                    end

                    if Goal then
                        TargetPos = Goal
                        local P = SolveBFS(Root.Position, Goal)
                        if P then 
                            CurrentPath = P 
                            Visuals:ClearAllChildren()
                            for _, pt in pairs(P) do
                                local p = Instance.new("Part", Visuals)
                                p.Size, p.Anchored, p.CanCollide, p.Position, p.Color, p.Shape = Vector3.new(0.5,0.5,0.5), true, false, pt, Color3.new(1,1,1), "Ball"
                            end
                        end
                    end
                end
            end
        end)

        local con; con = RunService.RenderStepped:Connect(function()
            if not getgenv().PathfindingThread then con:Disconnect() return end
            if #CurrentPath > 0 then
                if (Root.Position - LastPosition).Magnitude < 0.1 then
                    StuckTime = StuckTime + task.wait()
                    if StuckTime > 0.5 then
                        if TargetPos then SolveBFS(Root.Position, TargetPos) end
                        Humanoid.Jump = true
                        StuckTime = 0
                    end
                else
                    StuckTime = 0
                end
                LastPosition = Root.Position

                local Node = CurrentPath[1]
                Humanoid:MoveTo(Node)
                if Node.Y > Root.Position.Y + 2 then Humanoid.Jump = true end
                if (Root.Position - Node).Magnitude < 2.5 then
                    table.remove(CurrentPath, 1)
                end
            end
        end)
    end)
end

PathToLoop()
