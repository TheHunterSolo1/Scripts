local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Pathfinding = {}
Pathfinding.__index = Pathfinding

local GRID_SIZE = 4
local SCAN_RANGE = 150

local function GetDistance(nodeA, nodeB)
	if not nodeA or not nodeB then return 0 end
	return (nodeA.Position - nodeB.Position).Magnitude
end

local function GetPosition(input)
	if typeof(input) == "Vector3" then return input end
	if typeof(input) == "Instance" then
		if input:IsA("BasePart") then return input.Position end
		if input:IsA("Model") then return input:GetPivot().Position end
	end
	return nil
end

function Pathfinding.new()
	local self = setmetatable({}, Pathfinding)
	self.Grid = {}
	self.Active = false
	self.FollowConnection = nil
	return self
end

function Pathfinding:GenerateGrid(centerPos)
	self.Grid = {}
	local startX = math.round(centerPos.X - SCAN_RANGE/2)
	local startZ = math.round(centerPos.Z - SCAN_RANGE/2)
	
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {LocalPlayer.Character, workspace.CurrentCamera}

	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {LocalPlayer.Character}

	for x = 0, SCAN_RANGE, GRID_SIZE do
		local worldX = startX + x
		self.Grid[worldX] = {}
		for z = 0, SCAN_RANGE, GRID_SIZE do
			local worldZ = startZ + z
			local rayOrigin = Vector3.new(worldX, centerPos.Y + 20, worldZ)
			local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -40, 0), rayParams)
			
			if rayResult then
				local isBlocked = false
				local parts = workspace:GetPartBoundsInBox(CFrame.new(rayResult.Position + Vector3.new(0, 2, 0)), Vector3.new(GRID_SIZE - 0.5, 3.5, GRID_SIZE - 0.5), overlapParams)
				
				for _, part in ipairs(parts) do
					if part.CanCollide or (part.Transparency < 0.9 and part.Transparency > 0) then
						isBlocked = true
						break
					end
				end
				
				self.Grid[worldX][worldZ] = {
					Position = rayResult.Position,
					x = worldX, 
					z = worldZ, 
					walkable = not isBlocked
				}
			end
		end
	end
end

function Pathfinding:FindNearestNode(position)
	if not position then return nil end
	local bestNode = nil
	local minDist = math.huge
	for _, col in pairs(self.Grid) do
		for _, node in pairs(col) do
			if node.walkable then
				local dist = (node.Position - position).Magnitude
				if dist < minDist then
					minDist = dist
					bestNode = node
				end
			end
		end
	end
	return bestNode
end

function Pathfinding:GetNeighbors(node)
	local neighbors = {}
	for i = -GRID_SIZE, GRID_SIZE, GRID_SIZE do
		for j = -GRID_SIZE, GRID_SIZE, GRID_SIZE do
			if i == 0 and j == 0 then continue end
			local row = self.Grid[node.x + i]
			local neighbor = row and row[node.z + j]
			if neighbor and neighbor.walkable then
				table.insert(neighbors, neighbor)
			end
		end
	end
	return neighbors
end

function Pathfinding:CalculatePath(startNode, endNode)
	if not startNode or not endNode then return nil end
	local openSet = {startNode}
	local closedSet = {}
	local nodeData = {[startNode] = {g = 0, h = GetDistance(startNode, endNode)}}
	nodeData[startNode].f = nodeData[startNode].h

	local iterations = 0
	while #openSet > 0 do
		iterations += 1
		if iterations > 1000 then break end
		
		local current = openSet[1]
		local currentIndex = 1
		for i = 2, #openSet do
			if nodeData[openSet[i]].f < nodeData[current].f then
				current = openSet[i]
				currentIndex = i
			end
		end
		
		table.remove(openSet, currentIndex)
		closedSet[current] = true
		
		if (current.Position - endNode.Position).Magnitude < GRID_SIZE then
			local path = {}
			local temp = current
			while temp do
				table.insert(path, temp)
				temp = nodeData[temp] and nodeData[temp].parent
			end
			return path
		end
		
		for _, neighbor in ipairs(self:GetNeighbors(current)) do
			if closedSet[neighbor] then continue end
			local gScore = nodeData[current].g + GetDistance(current, neighbor)
			if not nodeData[neighbor] or gScore < nodeData[neighbor].g then
				nodeData[neighbor] = {
					g = gScore,
					h = GetDistance(neighbor, endNode),
					f = gScore + GetDistance(neighbor, endNode),
					parent = current
				}
				if not table.find(openSet, neighbor) then table.insert(openSet, neighbor) end
			end
		end
	end
	return nil
end

function Pathfinding:WalkPath(destinationInput)
	self:StopPath()
	local destPos = GetPosition(destinationInput)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	
	if not hrp or not hum or not destPos then return end

	self:GenerateGrid(hrp.Position)
	local startNode = self:FindNearestNode(hrp.Position)
	local endNode = self:FindNearestNode(destPos)
	
	if not startNode or not endNode then 
		warn("Pathfinding: Nodes not found.")
		return 
	end

	local path = self:CalculatePath(startNode, endNode)
	if not path or #path == 0 then 
		warn("Pathfinding: No valid path found.")
		return 
	end

	self.Active = true
	local index = #path
	self.FollowConnection = RunService.Heartbeat:Connect(function()
		if not self.Active or index < 1 then self:StopPath() return end
		local target = path[index]
		if target then
			hum:MoveTo(target.Position)
			if (hrp.Position - target.Position).Magnitude < 3 then
				index -= 1
			end
		end
	end)
end

function Pathfinding:StopPath()
	self.Active = false
	if self.FollowConnection then self.FollowConnection:Disconnect() self.FollowConnection = nil end
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
	if hum then hum:Move(Vector3.zero) end
end

return Pathfinding
