local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Pathfinding = {}
Pathfinding.__index = Pathfinding

local function GetDistance(nodeA, nodeB)
	local dx = math.abs(nodeA.x - nodeB.x)
	local dy = math.abs(nodeA.y - nodeB.y)
	return (dx > dy) and (14 * dy + 10 * (dx - dy)) or (14 * dx + 10 * (dy - dx))
end

function Pathfinding.new(gridData)
	local self = setmetatable({}, Pathfinding)
	self.Grid = gridData
	self.Active = false
	self.FollowConnection = nil
	return self
end

function Pathfinding:FindNearestNode(position)
	local targetX, targetY = math.round(position.X), math.round(position.Z)
	if self.Grid[targetX] and self.Grid[targetX][targetY] then
		return self.Grid[targetX][targetY]
	end
	
	local nearest = nil
	local minDist = math.huge
	for x, column in pairs(self.Grid) do
		for y, node in pairs(column) do
			if node.walkable then
				local d = (Vector2.new(x, y) - Vector2.new(position.X, position.Z)).SqrMagnitude
				if d < minDist then
					minDist = d
					nearest = node
				end
			end
		end
	end
	return nearest
end

function Pathfinding:GetNeighbors(node)
	local neighbors = {}
	local grid = self.Grid
	local x, y = node.x, node.y
	for i = -1, 1 do
		local row = grid[x + i]
		if not row then continue end
		for j = -1, 1 do
			if i == 0 and j == 0 then continue end
			local neighbor = row[y + j]
			if neighbor and neighbor.walkable then
				table.insert(neighbors, neighbor)
			end
		end
	end
	return neighbors
end

function Pathfinding:CalculatePath(startNode, endNode)
	local openSet = {startNode}
	local closedSet = {}
	local nodeData = {}
	nodeData[startNode] = {g = 0, h = GetDistance(startNode, endNode)}
	nodeData[startNode].f = nodeData[startNode].g + nodeData[startNode].h

	while #openSet > 0 do
		local currentNode = openSet[1]
		local currentIndex = 1
		for i = 2, #openSet do
			local node = openSet[i]
			if nodeData[node].f < nodeData[currentNode].f or (nodeData[node].f == nodeData[currentNode].f and nodeData[node].h < nodeData[currentNode].h) then
				currentNode = node
				currentIndex = i
			end
		end
		table.remove(openSet, currentIndex)
		closedSet[currentNode] = true
		if currentNode == endNode then
			local path = {}
			local curr = endNode
			while curr do
				table.insert(path, curr)
				curr = nodeData[curr] and nodeData[curr].parent
			end
			return path
		end
		for _, neighbor in ipairs(self:GetNeighbors(currentNode)) do
			if closedSet[neighbor] then continue end
			local gScore = nodeData[currentNode].g + GetDistance(currentNode, neighbor)
			if not nodeData[neighbor] or gScore < nodeData[neighbor].g then
				nodeData[neighbor] = {
					g = gScore,
					h = GetDistance(neighbor, endNode),
					f = gScore + GetDistance(neighbor, endNode),
					parent = currentNode
				}
				if not table.find(openSet, neighbor) then table.insert(openSet, neighbor) end
			end
		end
	end
	return nil
end

function Pathfinding:WalkPath(destinationVector)
	self:StopPath()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	if not hrp or not hum then return end

	local startNode = self:FindNearestNode(hrp.Position)
	local endNode = self:FindNearestNode(destinationVector)
	if not startNode or not endNode then return end

	local path = self:CalculatePath(startNode, endNode)
	if not path then return end

	self.Active = true
	local index = #path - 1
	self.FollowConnection = RunService.Heartbeat:Connect(function()
		if not self.Active or index < 1 then self:StopPath() return end
		local target = path[index]
		local targetPos = Vector3.new(target.x, hrp.Position.Y, target.y)
		hum:MoveTo(targetPos)
		if (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(target.x, target.y)).Magnitude < 1.5 then
			index -= 1
		end
	end)
end

function Pathfinding:StopPath()
	self.Active = false
	if self.FollowConnection then
		self.FollowConnection:Disconnect()
		self.FollowConnection = nil
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChild("Humanoid")
	if hum then hum:Move(Vector3.zero) end
end

function Pathfinding:Unload()
	self:StopPath()
	self.Grid = nil
	setmetatable(self, nil)
end

return Pathfinding
