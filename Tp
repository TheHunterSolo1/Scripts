	Settings.Offset = Vector3.new(Settings.Offset.X, Settings.Offset.Y, v)
end)

--==============================================================
-- TARGET RESOLUTION
--==============================================================
local function resolveTarget()
	local q = Settings.Query
	if q == "" then return nil end
	q = string.lower(q)

	local exact, prefix, partial

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local n  = string.lower(plr.Name)
			local dn = string.lower(plr.DisplayName)

			if n == q or dn == q then
				return plr
			elseif not prefix and (string.sub(n, 1, #q) == q or string.sub(dn, 1, #q) == q) then
				prefix = plr
			elseif not partial and (string.find(n, q, 1, true) or string.find(dn, q, 1, true)) then
				partial = plr
			end
		end
	end

	return prefix or partial
end

--==============================================================
-- STATUS
--==============================================================
local function updateStatus()
	if not Settings.Enabled then
		status.Text = "Idle"
		status.TextColor3 = C.Sub
		statusDot.BackgroundColor3 = C.Sub
		return
	end

	local t = resolveTarget()
	if t then
		status.Text = "Following  " .. t.Name
		status.TextColor3 = C.Green
		statusDot.BackgroundColor3 = C.Green
	else
		status.Text = (Settings.Query == "" and "Type a player name" or "No player found")
		status.TextColor3 = C.Red
		statusDot.BackgroundColor3 = C.Red
	end
end

--==============================================================
-- TOGGLE
--==============================================================
local function setToggle(on)
	Settings.Enabled = on

	local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	TweenService:Create(switch, info, {
		BackgroundColor3 = on and C.Green or C.Track,
	}):Play()

	TweenService:Create(switchKnob, info, {
		Position = on and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
	}):Play()

	updateStatus()
end

