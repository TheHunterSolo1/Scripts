-- dragging the panel
local dragging, dragStart, startPos = false, nil, nil

dragArea.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging  = true
		dragStart = input.Position
		startPos  = main.Position

		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				conn:Disconnect()
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragStart then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end
end)

--==============================================================
-- RESPONSIVE SCALING
--==============================================================
local function updateUIScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local s = math.min(vp.X / 340, vp.Y / 430)
	uiScale.Scale = math.clamp(s, 0.72, 1.15)
end

updateUIScale()

local function hookCamera()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIScale)
	end
end

hookCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	hookCamera()
	updateUIScale()
end)

--==============================================================
-- HEARTBEAT LOOP  (teleport + offsets + sethiddenproperty)
--==============================================================
local activeTarget = nil

RunService.Heartbeat:Connect(function()
	local character = LocalPlayer.Character
	local myRoot    = character and character:FindFirstChild("HumanoidRootPart")

	-- ---- OFF : release the physics rep root ----
	if not Settings.Enabled then
		if activeTarget then
			activeTarget = nil
			if myRoot and hasSHP then
				pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", myRoot)
			end
		end
		return
	end

	if not myRoot then return end

	-- ---- resolve target ----
	local target = resolveTarget()
	if not target then return end

	local tChar = target.Character
	local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
	if not tRoot then return end

	activeTarget = target

	-- ---- sethiddenproperty trick ----
	if hasSHP then
		pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", tRoot)
	end

	-- ---- apply position with sliders offset ----
	local o = Settings.Offset
	myRoot.CFrame = tRoot.CFrame * CFrame.new(o.X, o.Y, o.Z)

	-- kill momentum so we don't jitter / fall
	myRoot.AssemblyLinearVelocity  = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero
end)

