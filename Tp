--==============================================================
local function createSlider(order, labelText, default, onChange)
	local row = make("Frame", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = sliderHolder,
	})

	make("TextLabel", {
		Size = UDim2.new(0, 160, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = labelText,
		TextColor3 = C.Sub,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLabel = make("TextLabel", {
		Size = UDim2.new(0, 60, 0, 16),
		Position = UDim2.new(1, -60, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(default),
		TextColor3 = C.Accent,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	-- transparent button = big touch target
	local track = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.new(0, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	local bar = make("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0.5, -3),
		BackgroundColor3 = C.Track,
		BorderSizePixel = 0,
		Parent = track,
	})
	make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })

	local fill = make("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

	local knob = make("Frame", {
		Size = UDim2.new(0, 18, 0, 18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = bar,
	})
	make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

	local function setValue(v, fire)
		v = math.clamp(math.floor(v + 0.5), MIN_V, MAX_V)
		local alpha = (v - MIN_V) / (MAX_V - MIN_V)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = (v > 0 and "+" or "") .. tostring(v)
		if fire ~= false and onChange then onChange(v) end
	end

	-- ---- input handling (mouse + touch) ----
	local dragging = false

	local function applyFromX(px)
		local abs = bar.AbsolutePosition
		local w   = bar.AbsoluteSize.X
		if w <= 0 then return end
		local alpha = math.clamp((px - abs.X) / w, 0, 1)
		setValue(MIN_V + alpha * (MAX_V - MIN_V))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			applyFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			applyFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(default, false)
	return setValue
end

