		ToggleButton.BackgroundColor3 = Color3.fromRGB(65, 105, 175)
		StatusLabel.TextColor3 = Color3.fromRGB(255, 190, 80)
	end
end

local function Notify(Text)
	if GuiDestroyed then
		return
	end

	NotificationId = NotificationId + 1

	local Notification = Instance.new("Frame")
	Notification.Size = UDim2.fromOffset(290, 46)
	Notification.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	Notification.BorderSizePixel = 0
	Notification.LayoutOrder = -NotificationId
	Notification.Parent = NotificationHolder

	local NotificationCorner = Instance.new("UICorner")
	NotificationCorner.CornerRadius = UDim.new(0, 8)
	NotificationCorner.Parent = Notification

	local NotificationStroke = Instance.new("UIStroke")
	NotificationStroke.Transparency = 0.5
	NotificationStroke.Parent = Notification

	local NotificationText = Instance.new("TextLabel")
	NotificationText.Size = UDim2.new(1, -20, 1, 0)
	NotificationText.Position = UDim2.fromOffset(10, 0)
	NotificationText.BackgroundTransparency = 1
	NotificationText.Text = Text
	NotificationText.TextSize = 13
	NotificationText.Font = Enum.Font.GothamMedium
	NotificationText.TextColor3 = Color3.fromRGB(255, 255, 255)
	NotificationText.TextWrapped = true
	NotificationText.Parent = Notification

	task.delay(3, function()
		if Notification and Notification.Parent then
			local Tween = TweenService:Create(
				Notification,
				TweenInfo.new(0.25),
				{BackgroundTransparency = 1}
			)

			Tween:Play()

			task.wait(0.3)

			if Notification then
				Notification:Destroy()
			end
		end
	end)
end

local function SetState(State)
	if CurrentState == State then
		UpdateGui()
		return
	end

	CurrentState = State
	UpdateGui()
end

local function RefreshCharacter(NewCharacter)
	Character = NewCharacter
	Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

	if DeathConnection then
		DeathConnection:Disconnect()
		DeathConnection = nil
	end

	if Humanoid then
		DeathConnection = Humanoid.Died:Connect(function()
			IsHandlingDeath = true
			SetState("Dead")
			Notify("Player died")
		end)
	end
end

local function GetTargetPosition(Target)
	if not Target then
		return nil
	end

	if Target:IsA("Model") then
		if Target.PrimaryPart then
			return Target.PrimaryPart.Position
		end

		return Target:GetPivot().Position
	end

	if Target:IsA("BasePart") then
		return Target.Position
	end

	return nil
end

local function IsValidDrawerItem(Target)
	if not Target or not Target:IsDescendantOf(workspace) then
		return false
	end

	if Target:GetAttribute("KnobFarmIgnored") then
		return false
	end

	local Name = Target.Name

	if Name == "GoldPile" or Name == "Stardust" then
		return true
	end

	if Name == "DrawerContainer" then
		local MainPart = Target:FindFirstChild("Main")

		if MainPart then
			local OpenSound = MainPart:FindFirstChild("Open")

			if OpenSound and OpenSound:IsA("Sound") and OpenSound.IsPlaying then
				Target:SetAttribute("KnobFarmIgnored", true)
				Drawers[Target] = nil
				return false
			end
		end

		return true
	end

	return false
end

local function IsValidWardrobeItem(Target)
	if not Target or not Target:IsDescendantOf(workspace) then
		return false
	end

	return Target.Name == "Wardrobe"
end

local function AddTrackedItem(Target)
	if IsValidDrawerItem(Target) then
		Drawers[Target] = true
	end

	if IsValidWardrobeItem(Target) then
		Wardrobes[Target] = true
	end
end

local function RemoveTrackedItem(Target)
	Drawers[Target] = nil
	Wardrobes[Target] = nil
end

local function GetNextValidDrawer()
	for Target in pairs(Drawers) do
		if IsValidDrawerItem(Target) then
			return Target
		end

		Drawers[Target] = nil
	end

	return nil
end

local function GetClosestWardrobe()
	if not RootPart then
		return nil
	end

	local Closest = nil
	local ShortestDistance = math.huge

	for Wardrobe in pairs(Wardrobes) do
		if IsValidWardrobeItem(Wardrobe) then
			local Position = GetTargetPosition(Wardrobe)

			if Position then
				local Distance = (RootPart.Position - Position).Magnitude

				if Distance < ShortestDistance then
					ShortestDistance = Distance
					Closest = Wardrobe
				end
			end
		else
			Wardrobes[Wardrobe] = nil
		end
	end

	return Closest
end

local function GetPrompt(Target)
	if not Target then
		return nil
	end

	if Target:IsA("ProximityPrompt") then
		return Target
	end

	local Prompt = Target:FindFirstChildOfClass("ProximityPrompt")

	if Prompt then
		return Prompt
	end

	for _, Descendant in ipairs(Target:GetDescendants()) do
		if Descendant:IsA("ProximityPrompt") then
			return Descendant
		end
	end

	return nil
end

local function FirePrompt(Target)
	if not Target then
		return false
	end

	local Now = os.clock()

	if Now - LastPromptFire < PROMPT_INTERVAL then
		return false
	end

	local Prompt = GetPrompt(Target)

	if not Prompt then
		return false
	end

	LastPromptFire = Now

	pcall(function()
		fireproximityprompt(Prompt)
	end)

	return true
end

local function PlayerHasKey()
	if Character and Character:FindFirstChild("Key") then
		return true
	end

	if Backpack and Backpack:FindFirstChild("Key") then
		return true
	end

	return false
end

local function TeleportToPosition(TargetPosition)
	if not Character or not RootPart or not TargetPosition then
		return
	end

	RootPart.CFrame = CFrame.new(TargetPosition)
end

local function IsPlayerReady()
	local CurrentPlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local MainUI = CurrentPlayerGui and CurrentPlayerGui:FindFirstChild("MainUI")
	local DeathPanel = MainUI and MainUI:FindFirstChild("DeathPanel")
	local PlayAgainUI = DeathPanel and DeathPanel:FindFirstChild("PlayAgain")
	local PlayersFolder = PlayAgainUI and PlayAgainUI:FindFirstChild("Players")
	local PlayerFrame = PlayersFolder and PlayersFolder:FindFirstChild(LocalPlayer.Name)
	local ReadyFrame = PlayerFrame and PlayerFrame:FindFirstChild("Ready")

	return ReadyFrame and ReadyFrame.Visible or false
end

local function HandleDeath()
	if not PlayAgainRemote then
		return
	end

	if IsPlayerReady() then
		IsHandlingDeath = false
		SetState("Recovering")
		Notify("Death recovery complete")
		return
	end

	if PlayAgainRemote:IsA("RemoteEvent") then
		pcall(function()
			PlayAgainRemote:FireServer()
		end)
	elseif PlayAgainRemote:IsA("RemoteFunction") then
		pcall(function()
			PlayAgainRemote:InvokeServer()
		end)
	end
end

local function UpdateRoom()
	if not LatestRoom then
		return
	end

	local NewRoom = LatestRoom.Value

	if NewRoom ~= CurrentRoomNumber then
		CurrentRoomNumber = NewRoom

		if NewRoom >= 50 then
			TargetRoomNumber = NewRoom + 1
		else
			TargetRoomNumber = NewRoom
		end

		UpdateGui()
		Notify("Room " .. tostring(NewRoom) .. " | Target " .. tostring(TargetRoomNumber))
	end
end

local function ProcessAutomation()
	if GuiDestroyed or not AutomationEnabled then
		return
	end

	local Now = os.clock()

	if Now - LastAutomationUpdate < AUTOMATION_INTERVAL then
		return
	end

	LastAutomationUpdate = Now

	if not Character or not RootPart or not Humanoid then
		return
	end

	if Humanoid.Health <= 0 then
		IsHandlingDeath = true
		SetState("Dead")
		HandleDeath()
		return
	end

	if IsHandlingDeath then
		if IsPlayerReady() then
			IsHandlingDeath = false
			SetState("Recovering")
		else
			HandleDeath()
			return
		end
	end

	if Crouch and Crouch:IsA("RemoteEvent") then
		pcall(function()
			Crouch:FireServer(false, true)
		end)
	end

	local ActiveEntity = workspace:FindFirstChild("RushMoving") or workspace:FindFirstChild("AmbushMoving")

	if ActiveEntity then
		SetState("Hiding")

		local Wardrobe = GetClosestWardrobe()

		if Wardrobe then
			local WardrobePosition = GetTargetPosition(Wardrobe)

			if WardrobePosition then
				TeleportToPosition(WardrobePosition)

				local EntityPosition = GetTargetPosition(ActiveEntity)

				if EntityPosition then
					local EntityDistance = (RootPart.Position - EntityPosition).Magnitude

					if EntityDistance < ENTITY_HIDE_DISTANCE then
						if not Character:GetAttribute("Hiding") then
							FirePrompt(Wardrobe)
						end
					elseif Character:GetAttribute("Hiding") then
						Character:SetAttribute("Hiding", false)
					end
				end
			end
		end

		return
	end

	if Character:GetAttribute("Hiding") then
		Character:SetAttribute("Hiding", false)
	end

	local DrawerTarget = GetNextValidDrawer()

	if DrawerTarget then
		SetState("Looting")

		local DrawerPosition = GetTargetPosition(DrawerTarget)

		if DrawerPosition then
			TeleportToPosition(DrawerPosition)

			FirePrompt(DrawerTarget)

			if DrawerTarget.Name == "DrawerContainer" then
				local MainPart = DrawerTarget:FindFirstChild("Main")

				if MainPart then
					local OpenSound = MainPart:FindFirstChild("Open")

					if OpenSound and OpenSound:IsA("Sound") and OpenSound.IsPlaying then
						DrawerTarget:SetAttribute("KnobFarmIgnored", true)
						Drawers[DrawerTarget] = nil
					end
				end
			end

			return
		end

		Drawers[DrawerTarget] = nil
	end

	if not CurrentRooms then
		return
	end

	local TargetRoom = CurrentRooms:FindFirstChild(tostring(TargetRoomNumber))

	if not TargetRoom then
		SetState("Waiting For Room")
		return
	end

	local KeyObtainModel = TargetRoom:FindFirstChild("KeyObtain", true)
	local DoorModel = TargetRoom:FindFirstChild("Door") or TargetRoom:FindFirstChild("Door", true)

	if not PlayerHasKey() and KeyObtainModel then
		SetState("Getting Key")

		local ParentContainer = KeyObtainModel.Parent

		if ParentContainer and ParentContainer.Name == "DrawerContainer" then
			local Knobs = ParentContainer:FindFirstChild("Knobs")

			if Knobs then
				FirePrompt(Knobs)
			end
		end

		local KeyPosition = GetTargetPosition(KeyObtainModel)

		if KeyPosition then
			TeleportToPosition(KeyPosition)
			FirePrompt(KeyObtainModel)
		end

		return
	end

	if DoorModel and RootPart then
		SetState("Opening Door")

		local DoorPosition = GetTargetPosition(DoorModel)

		if not DoorPosition then
			return
		end

		local DistanceToDoor = (RootPart.Position - DoorPosition).Magnitude

		if DistanceToDoor > DISTANCE_THRESHOLD then
			TeleportToPosition(DoorPosition)
		end

		DistanceToDoor = (RootPart.Position - DoorPosition).Magnitude

		if DistanceToDoor <= DISTANCE_THRESHOLD then
			local ClientOpenRemote = DoorModel:FindFirstChild("ClientOpen")

			if ClientOpenRemote and ClientOpenRemote:IsA("RemoteEvent") then
				pcall(function()
					ClientOpenRemote:FireServer()
				end)
			end

			local LockModel = DoorModel:FindFirstChild("Lock")

			FirePrompt(LockModel or DoorModel)
		end

		return
	end

	SetState("Waiting")
end

local Dragging = false
local DragStart = nil
local StartPosition = nil

TopBar.InputBegan:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
		Dragging = true
		DragStart = Input.Position
		StartPosition = Main.Position
	end
end)

TopBar.InputEnded:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(Input)
	if not Dragging then
		return
	end

	if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local Delta = Input.Position - DragStart

	Main.Position = UDim2.new(
		StartPosition.X.Scale,
		StartPosition.X.Offset + Delta.X,
		StartPosition.Y.Scale,
		StartPosition.Y.Offset + Delta.Y
	)
end)

ToggleButton.Activated:Connect(function()
	AutomationEnabled = not AutomationEnabled

	if AutomationEnabled then
		SetState("Running")
		Notify("Automation started")
	else
		SetState("Stopped")
		Notify("Automation stopped")
	end
end)

DestroyButton.Activated:Connect(function()
	GuiDestroyed = true
	AutomationEnabled = false

	if AutomationConnection then
		AutomationConnection:Disconnect()
		AutomationConnection = nil
	end

	if CharacterConnection then
		CharacterConnection:Disconnect()
		CharacterConnection = nil
	end

	if RoomConnection then
		RoomConnection:Disconnect()
		RoomConnection = nil
	end

	if DeathConnection then
		DeathConnection:Disconnect()
		DeathConnection = nil
	end

	ScreenGui:Destroy()
end)

workspace.DescendantAdded:Connect(AddTrackedItem)
workspace.DescendantRemoving:Connect(RemoveTrackedItem)

CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(NewCharacter)
	task.wait(0.25)

	RefreshCharacter(NewCharacter)

	IsHandlingDeath = false
	AutomationEnabled = true

	SetState("Running")
	Notify("Character loaded")
end)

if LatestRoom then
	CurrentRoomNumber = LatestRoom.Value

	if CurrentRoomNumber >= 50 then
		TargetRoomNumber = CurrentRoomNumber + 1
	else
		TargetRoomNumber = CurrentRoomNumber
	end

	RoomConnection = LatestRoom:GetPropertyChangedSignal("Value"):Connect(UpdateRoom)
end

for _, Descendant in ipairs(workspace:GetDescendants()) do
	AddTrackedItem(Descendant)
end

RefreshCharacter(Character)

AutomationConnection = RunService.Heartbeat:Connect(ProcessAutomation)

UpdateGui()
Notify("Knob Farm started")