if not fireproximityprompt then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local DISTANCE_THRESHOLD = 5
local IsHandlingDeath = false

local Drawers = {}
local Wardrobes = {}

local QueueOnTeleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
if QueueOnTeleport then
	pcall(QueueOnTeleport, [[
		repeat task.wait() until game:IsLoaded()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/TheHunterSolo1/Scripts/main/KnobFarm"))()
	]])
end

local RemotesFolder = ReplicatedStorage:WaitForChild("RemotesFolder", 5)
local Crouch = RemotesFolder and RemotesFolder:FindFirstChild("Crouch")
if not Crouch then
	Crouch = ReplicatedStorage:FindFirstChild("Crouch", true)
end

local PlayAgainRemote = RemotesFolder and RemotesFolder:FindFirstChild("PlayAgain")
if not PlayAgainRemote then
	PlayAgainRemote = ReplicatedStorage:FindFirstChild("PlayAgain", true)
end

local function FirePrompt(TargetInstance)
	if not TargetInstance then return end

	if TargetInstance:IsA("ProximityPrompt") then
		fireproximityprompt(TargetInstance)
		return
	end

	local Prompt = TargetInstance:FindFirstChildOfClass("ProximityPrompt")
	if Prompt then
		fireproximityprompt(Prompt)
		return
	end

	for _, Descendant in ipairs(TargetInstance:GetDescendants()) do
		if Descendant:IsA("ProximityPrompt") then
			fireproximityprompt(Descendant)
			return
		end
	end
end

local function IsValidDrawerItem(TargetInstance)
	if not TargetInstance or not TargetInstance:IsDescendantOf(workspace) then
		return false
	end

	local Name = TargetInstance.Name
	if Name == "GoldPile" or Name == "Stardust" or Name == "DrawerContainer" then
		if Name == "DrawerContainer" then
			local Main = TargetInstance:FindFirstChild("Main")
			if Main then
				local OpenSound = Main:FindFirstChild("Open")
				if OpenSound and OpenSound:IsA("Sound") and OpenSound.IsPlaying then
					return false
				end
			end
		end
		return true
	end

	return false
end

local function IsValidWardrobeItem(TargetInstance)
	if not TargetInstance or not TargetInstance:IsDescendantOf(workspace) then
		return false
	end
	return TargetInstance.Name == "Wardrobe"
end

local function AddTrackedItem(TargetInstance)
	if IsValidDrawerItem(TargetInstance) and not table.find(Drawers, TargetInstance) then
		table.insert(Drawers, TargetInstance)
	end
	if IsValidWardrobeItem(TargetInstance) and not table.find(Wardrobes, TargetInstance) then
		table.insert(Wardrobes, TargetInstance)
	end
end

for _, Descendant in ipairs(workspace:GetDescendants()) do
	AddTrackedItem(Descendant)
end
workspace.DescendantAdded:Connect(AddTrackedItem)

local function GetNextValidDrawer()
	while #Drawers > 0 do
		local Item = Drawers[1]
		if not IsValidDrawerItem(Item) then
			table.remove(Drawers, 1)
		else
			return Item
		end
	end
	return nil
end

local function GetTargetPosition(Target)
	if not Target then return nil end
	if Target:IsA("Model") then
		return Target.PrimaryPart and Target.PrimaryPart.Position or Target:GetPivot().Position
	elseif Target:IsA("BasePart") then
		return Target.Position
	end
	return nil
end

local function GetClosestWardrobe()
	local Character = LocalPlayer.Character
	if not Character then return nil end

	local RootPart = Character:FindFirstChild("HumanoidRootPart")
	if not RootPart then return nil end

	local Closest = nil
	local ShortestDistance = math.huge

	for Index = #Wardrobes, 1, -1 do
		local Wardrobe = Wardrobes[Index]
		if IsValidWardrobeItem(Wardrobe) then
			local Pos = GetTargetPosition(Wardrobe)
			if Pos then
				local Dist = (RootPart.Position - Pos).Magnitude
				if Dist < ShortestDistance then
					ShortestDistance = Dist
					Closest = Wardrobe
				end
			end
		else
			table.remove(Wardrobes, Index)
		end
	end

	return Closest
end

local function PlayerHasKey()
	local Character = LocalPlayer.Character
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local KeyInChar = Character and Character:FindFirstChild("Key")
	local KeyInBackpack = Backpack and Backpack:FindFirstChild("Key")
	return (KeyInChar or KeyInBackpack) ~= nil
end

local function TeleportToPosition(Character, TargetPosition)
	local RootPart = Character:FindFirstChild("HumanoidRootPart")
	if RootPart and TargetPosition then
		RootPart.CFrame = CFrame.new(TargetPosition)
	end
end

local function IsPlayerReady()
	local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local MainUI = PlayerGui and PlayerGui:FindFirstChild("MainUI")
	local DeathPanel = MainUI and MainUI:FindFirstChild("DeathPanel")
	local PlayAgainUI = DeathPanel and DeathPanel:FindFirstChild("PlayAgain")
	local PlayersFolder = PlayAgainUI and PlayAgainUI:FindFirstChild("Players")
	local PlayerFrame = PlayersFolder and PlayersFolder:FindFirstChild(LocalPlayer.Name)
	local ReadyFrame = PlayerFrame and PlayerFrame:FindFirstChild("Ready")
	return ReadyFrame and ReadyFrame.Visible or false
end

local function HandlePlayerDeath()
	if IsHandlingDeath then return end
	IsHandlingDeath = true

	task.spawn(function()
		while task.wait(0.2) do
			if not IsPlayerReady() and PlayAgainRemote then
				if PlayAgainRemote:IsA("RemoteEvent") then
					PlayAgainRemote:FireServer()
				elseif PlayAgainRemote:IsA("RemoteFunction") then
					pcall(function() PlayAgainRemote:InvokeServer() end)
				end
			end
		end
	end)
end

local function ProcessAutomation()
	if Crouch and Crouch:IsA("RemoteEvent") then
		Crouch:FireServer(false, true)
	end

	local Character = LocalPlayer.Character
	if not Character then return end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if Humanoid and Humanoid.Health <= 0 then
		HandlePlayerDeath()
		return
	end

	if IsHandlingDeath then return end

	local GameData = ReplicatedStorage:FindFirstChild("GameData")
	local LatestRoom = GameData and GameData:FindFirstChild("LatestRoom")
	local CurrentRoomVal = LatestRoom and LatestRoom.Value or 0

	local TargetRoomNum = CurrentRoomVal
	if CurrentRoomVal >= 50 then
		TargetRoomNum = CurrentRoomVal + 1
	end

	local ActiveEntity = workspace:FindFirstChild("RushMoving") or workspace:FindFirstChild("AmbushMoving")
	local RootPart = Character:FindFirstChild("HumanoidRootPart")

	if ActiveEntity then
		local Wardrobe = GetClosestWardrobe()
		if Wardrobe then
			local WardrobePos = GetTargetPosition(Wardrobe)
			if WardrobePos then
				TeleportToPosition(Character, WardrobePos)

				local EntityPos = GetTargetPosition(ActiveEntity)
				if EntityPos and RootPart then
					local EntityDistance = (RootPart.Position - EntityPos).Magnitude
					
					if EntityDistance < 130 then
						if not Character:GetAttribute("Hiding") then
							FirePrompt(Wardrobe)
						end
					else
						if Character:GetAttribute("Hiding") then
							Character:SetAttribute("Hiding", false)
						end
					end
				end
			end
		end
		return
	else
		if Character and Character:GetAttribute("Hiding") then
			Character:SetAttribute("Hiding", false)
		end
	end

	local DrawerTarget = GetNextValidDrawer()
	if DrawerTarget then
		local TargetPosition = GetTargetPosition(DrawerTarget)
		if TargetPosition then
			TeleportToPosition(Character, TargetPosition)
			FirePrompt(DrawerTarget)

			if DrawerTarget.Name == "DrawerContainer" then
				local Main = DrawerTarget:FindFirstChild("Main")
				if Main then
					local OpenSound = Main:FindFirstChild("Open")
					if OpenSound and OpenSound:IsA("Sound") and OpenSound.IsPlaying then
						table.remove(Drawers, 1)
					end
				end
			end
			return
		else
			table.remove(Drawers, 1)
		end
	end

	local CurrentRoom = workspace.CurrentRooms:FindFirstChild(tostring(TargetRoomNum))
	if not CurrentRoom then return end

	local KeyObtainModel = CurrentRoom:FindFirstChild("KeyObtain", true)
	local DoorModel = CurrentRoom:FindFirstChild("Door") or CurrentRoom:FindFirstChild("Door", true)

	if not PlayerHasKey() and KeyObtainModel then
		local ParentContainer = KeyObtainModel.Parent
		if ParentContainer and ParentContainer.Name == "DrawerContainer" then
			local Knobs = ParentContainer:FindFirstChild("Knobs")
			if Knobs then
				FirePrompt(Knobs)
			end
		end

		local KeyPosition = GetTargetPosition(KeyObtainModel)
		if KeyPosition then
			TeleportToPosition(Character, KeyPosition)
			FirePrompt(KeyObtainModel)
		end
	elseif DoorModel and RootPart then
		local DoorPosition = GetTargetPosition(DoorModel)
		if not DoorPosition then return end

		local DistanceToDoor = (RootPart.Position - DoorPosition).Magnitude
		if DistanceToDoor > DISTANCE_THRESHOLD then
			TeleportToPosition(Character, DoorPosition)
		end

		DistanceToDoor = (RootPart.Position - DoorPosition).Magnitude
		if DistanceToDoor <= DISTANCE_THRESHOLD then
			local ClientOpenRemote = DoorModel:FindFirstChild("ClientOpen")
			if ClientOpenRemote and ClientOpenRemote:IsA("RemoteEvent") then
				ClientOpenRemote:FireServer()
			end

			local LockModel = DoorModel:FindFirstChild("Lock")
			FirePrompt(LockModel or DoorModel)
		end
	end
end

RunService.Heartbeat:Connect(ProcessAutomation)
