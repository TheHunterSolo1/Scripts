		return
	end

	StatusLabel.Text = "Status: " .. CurrentState
	RoomLabel.Text = "Room: " .. tostring(CurrentRoomNumber)
	TargetLabel.Text = "Target: " .. tostring(TargetRoomNumber)

	if AutomationEnabled then
		ToggleButton.Text = "STOP"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(45, 145, 75)
		StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 140)
	else
