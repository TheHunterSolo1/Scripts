local UserInputService = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Device = UserInputService.TouchEnabled and "Mobile" or UserInputService.KeyboardEnabled and "PC"
local CoreGui = gethui and gethui() or game:GetService("CoreGui")
local LP = Players.LocalPlayer

local Library = {
    Settings = {
        Tracers = true,
        Distance = true,
        Arrows = true,
        Rainbow = false,
        MaxDistance = 999999,
        TextSize = 25,
        Font = Enum.Font.RobotoMono,
        FadeTime = 0.7,
        ESPMode = "Highlight/Text",
        RenderTime = (Device == "PC" and 240 or Device == "Mobile" and 30) or 60,
    },
    Cache = {},
    ActiveDelays = {},
    TweenInfoFadeIn = nil,
    TweenInfoFadeOut = nil,
}

local Screen = Instance.new("ScreenGui")
Screen.Name = HttpService:GenerateGUID(false)
Screen.IgnoreGuiInset = true
Screen.Parent = CoreGui

function Library:RebuildTweenInfo()
    local FT = self.Settings.FadeTime
    self.TweenInfoFadeIn = TweenInfo.new(FT, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    self.TweenInfoFadeOut = TweenInfo.new(FT, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
end

Library:RebuildTweenInfo()

local function GetRoot(Obj)
    if not Obj then return nil end
    if Obj:IsA("Model") then
        return Obj.PrimaryPart or Obj:FindFirstChild("HumanoidRootPart") or Obj:FindFirstChildWhichIsA("BasePart")
    end
    if Obj:IsA("BasePart") then
        return Obj
    end
    return nil
end

function Library:SetFont(Font)
    self.Settings.Font = Font
    for _, Data in pairs(self.Cache) do
        Data.Text.Font = Font
    end
end

function Library:SetRainbow(Bool)
    self.Settings.Rainbow = Bool
end

function Library:SetFadeTime(Value)
    self.Settings.FadeTime = Value
    self:RebuildTweenInfo()
end

function Library:SetArrows(Bool)
    self.Settings.Arrows = Bool
end

function Library:SetTracers(Bool)
    self.Settings.Tracers = Bool
end

function Library:SetShowDistance(Bool)
    self.Settings.Distance = Bool
end

function Library:SetESPMode(Value)
    self.Settings.ESPMode = Value
end

function Library:SetRenderingSpeed(Value)
    self.Settings.RenderTime = Value
end

function Library:HasESP(Obj)
    return self.Cache[Obj] ~= nil
end

function Library:GetESPData(Obj)
    return self.Cache[Obj]
end

function Library:GetAllESP()
    local Result = {}
    for Obj, Data in pairs(self.Cache) do
        Result[Obj] = {
            Name = Data.Name,
            Color = Data.Color,
            Root = Data.Root,
        }
    end
    return Result
end

function Library:CountESP()
    local Count = 0
    for _ in pairs(self.Cache) do
        Count = Count + 1
    end
    return Count
end

function Library:AddESP(Cfg)
    local Obj = Cfg.Object
    if not Obj then return end
    if self.Cache[Obj] then return end

    local Root = GetRoot(Obj)
    if not Root then
        task.spawn(function()
            local Attempts = 0
            while not Root and Attempts < 60 do
                Root = GetRoot(Obj)
                Attempts = Attempts + 1
                task.wait(0.5)
            end
            if Root and Obj.Parent then
                self:AddESP(Cfg)
            end
        end)
        return
    end

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = HttpService:GenerateGUID(false)
    Billboard.Size = UDim2.new(0, 250, 0, 60)
    Billboard.AlwaysOnTop = true
    Billboard.Adornee = Root
    Billboard.MaxDistance = self.Settings.MaxDistance
    Billboard.Parent = Obj

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.TextColor3 = Cfg.Color
    Label.Font = self.Settings.Font
    Label.TextSize = self.Settings.TextSize
    Label.TextStrokeTransparency = 0
    Label.TextTransparency = 1
    Label.Text = Cfg.Text
    Label.Parent = Billboard

    local Highlight = Instance.new("Highlight")
    Highlight.Adornee = Obj
    Highlight.FillColor = Cfg.Color
    Highlight.FillTransparency = 1
    Highlight.OutlineTransparency = 1
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Obj

    local Line = Instance.new("Frame")
    Line.AnchorPoint = Vector2.new(0.5, 0.5)
    Line.BorderSizePixel = 0
    Line.BackgroundColor3 = Cfg.Color
    Line.Visible = true
    Line.BackgroundTransparency = 1
    Line.Parent = Screen

    local Arrow = Instance.new("ImageLabel")
    Arrow.BackgroundTransparency = 1
    Arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    Arrow.Size = UDim2.new(0, 32, 0, 32)
    Arrow.Image = "rbxassetid://10526559647"
    Arrow.ImageColor3 = Cfg.Color
    Arrow.Visible = false
    Arrow.Parent = Screen

    local FT = self.Settings.FadeTime
    if FT > 0 then
        TweenService:Create(Label, self.TweenInfoFadeIn, {TextTransparency = 0}):Play()
        TweenService:Create(Highlight, self.TweenInfoFadeIn, {FillTransparency = 0.6}):Play()
        TweenService:Create(Line, self.TweenInfoFadeIn, {BackgroundTransparency = 0}):Play()
    else
        Label.TextTransparency = 0
        Highlight.FillTransparency = 0.6
        Line.BackgroundTransparency = 0
    end

    self.Cache[Obj] = {
        Tag = Billboard,
        Text = Label,
        Line = Line,
        Box = Highlight,
        Arrow = Arrow,
        Name = Cfg.Text,
        Color = Cfg.Color,
        Root = Root,
    }
end

function Library:RemoveESP(Obj)
    local Data = self.Cache[Obj]
    if not Data then return end
    self.Cache[Obj] = nil

    local FT = self.Settings.FadeTime
    if FT > 0 then
        local DelayId = HttpService:GenerateGUID(false)
        self.ActiveDelays[DelayId] = true

        TweenService:Create(Data.Text, self.TweenInfoFadeOut, {TextTransparency = 1}):Play()
        TweenService:Create(Data.Box, self.TweenInfoFadeOut, {FillTransparency = 1}):Play()
        TweenService:Create(Data.Line, self.TweenInfoFadeOut, {BackgroundTransparency = 1}):Play()

        task.delay(FT, function()
            if self.ActiveDelays[DelayId] then
                self.ActiveDelays[DelayId] = nil
                if Data.Tag then Data.Tag:Destroy() end
                if Data.Line then Data.Line:Destroy() end
                if Data.Box then Data.Box:Destroy() end
                if Data.Arrow then Data.Arrow:Destroy() end
            end
        end)
    else
        if Data.Tag then Data.Tag:Destroy() end
        if Data.Line then Data.Line:Destroy() end
        if Data.Box then Data.Box:Destroy() end
        if Data.Arrow then Data.Arrow:Destroy() end
    end
end

function Library:UpdateESP(Obj, NewText, NewColor)
    local Data = self.Cache[Obj]
    if Data then
        if NewText and Data.Name ~= NewText then
            Data.Name = NewText
            Data.Text.Text = NewText
        end
        if NewColor and Data.Color ~= NewColor then
            Data.Color = NewColor
            Data.Text.TextColor3 = NewColor
            Data.Box.FillColor = NewColor
            Data.Line.BackgroundColor3 = NewColor
            Data.Arrow.ImageColor3 = NewColor
        end
    else
        self:AddESP({Object = Obj, Text = NewText or "ESP", Color = NewColor or Color3.new(1, 1, 1)})
    end
end

function Library:BulkUpdateESP(UpdateTable)
    for Obj, Info in pairs(UpdateTable) do
        local Data = self.Cache[Obj]
        if Data then
            local NeedsColorUpdate = false
            if Info.Text and Data.Name ~= Info.Text then
                Data.Name = Info.Text
                Data.Text.Text = Info.Text
            end
            if Info.Color and Data.Color ~= Info.Color then
                Data.Color = Info.Color
                NeedsColorUpdate = true
            end
            if NeedsColorUpdate then
                local Color = Info.Color
                Data.Text.TextColor3 = Color
                Data.Box.FillColor = Color
                Data.Line.BackgroundColor3 = Color
                Data.Arrow.ImageColor3 = Color
            end
        else
            if Info.Text and Info.Color then
                self:AddESP({Object = Obj, Text = Info.Text, Color = Info.Color})
            end
        end
    end
end

function Library:ClearAllESP()
    local Objects = {}
    for Obj in pairs(self.Cache) do
        table.insert(Objects, Obj)
    end
    for i = 1, #Objects do
        self:RemoveESP(Objects[i])
    end
end

function Library:Unload()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end

    for DelayId in pairs(self.ActiveDelays) do
        self.ActiveDelays[DelayId] = nil
    end

    for Obj in pairs(self.Cache) do
        local Data = self.Cache[Obj]
        self.Cache[Obj] = nil
        if Data then
            if Data.Tag then Data.Tag:Destroy() end
            if Data.Line then Data.Line:Destroy() end
            if Data.Box then Data.Box:Destroy() end
            if Data.Arrow then Data.Arrow:Destroy() end
        end
    end

    if Screen then
        Screen:Destroy()
    end
end

local Camera = workspace.CurrentCamera
local ScreenCenter = Camera.ViewportSize / 2
local FOVScale = Camera.FieldOfView / 70
local RainbowColor = Color3.fromHSV(0, 1, 1)
local LastUpdateTick = tick()

Library.Connection = RS.Heartbeat:Connect(function()
    local RenderInterval = 1 / Library.Settings.RenderTime
    if tick() - LastUpdateTick < RenderInterval then return end
    LastUpdateTick = tick()

    Camera = workspace.CurrentCamera
    local ViewportSize = Camera.ViewportSize
    ScreenCenter = ViewportSize / 2
    FOVScale = Camera.FieldOfView / 70
    RainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
    local CameraCFrame = Camera.CFrame

    for Object, Data in pairs(Library.Cache) do
        if not Object or not Object.Parent then
            Library:RemoveESP(Object)
            continue
        end

        local RootPart = Data.Root
        if not RootPart or not RootPart.Parent then
            Data.Root = GetRoot(Object)
            RootPart = Data.Root
            if not RootPart then continue end
        end

        local ScreenPosition, IsOnScreen = Camera:WorldToViewportPoint(RootPart.Position)
        local DisplayColor = Library.Settings.Rainbow and RainbowColor or Data.Color
        local CalculatedDistance = Data.Tag.CurrentDistance

        if CalculatedDistance > Library.Settings.MaxDistance then
            Data.Tag.Enabled = false
            Data.Text.Visible = false
            Data.Box.Enabled = false
            Data.Line.Visible = false
            Data.Arrow.Visible = false
            continue
        end

        if IsOnScreen then
            local ESPMode = Library.Settings.ESPMode
            local ShowHighlight = ESPMode == "Highlight" or ESPMode == "Highlight/Text"
            local ShowText = ESPMode == "Text" or ESPMode == "Highlight/Text"

            Data.Tag.Enabled = true
            Data.Arrow.Visible = false

            if ShowText then
                Data.Text.Visible = true
                Data.Text.TextColor3 = DisplayColor
                Data.Text.TextSize = Library.Settings.TextSize * FOVScale
                local DistanceStr = ""
                if Library.Settings.Distance then
                    DistanceStr = "\n[" .. math.floor(CalculatedDistance) .. "m]"
                end
                Data.Text.Text = Data.Name .. DistanceStr
            else
                Data.Text.Visible = false
            end

            if ShowHighlight then
                Data.Box.Enabled = true
                Data.Box.FillColor = DisplayColor
            else
                Data.Box.Enabled = false
            end

            if Library.Settings.Tracers and CalculatedDistance < 1500 then
                local ScreenPoint = Vector2.new(ScreenPosition.X, ScreenPosition.Y)
                local OriginPoint = Vector2.new(ScreenCenter.X, ViewportSize.Y)
                local VectorDifference = ScreenPoint - OriginPoint

                Data.Line.Visible = true
                Data.Line.BackgroundColor3 = DisplayColor
                Data.Line.Size = UDim2.new(0, VectorDifference.Magnitude, 0, 1)
                Data.Line.Position = UDim2.new(0, OriginPoint.X + VectorDifference.X / 2, 0, OriginPoint.Y + VectorDifference.Y / 2)
                Data.Line.Rotation = math.deg(math.atan2(VectorDifference.Y, VectorDifference.X))
            else
                Data.Line.Visible = false
            end
        else
            Data.Tag.Enabled = false
            Data.Text.Visible = false
            Data.Box.Enabled = false
            Data.Line.Visible = false

            if Library.Settings.Arrows then
                local ObjectRelativeSpace = CameraCFrame:PointToObjectSpace(RootPart.Position)
                local DirectionAngle = math.atan2(-ObjectRelativeSpace.X, -ObjectRelativeSpace.Z)
                local Radius = ViewportSize.Y * 0.4

                Data.Arrow.Visible = true
                Data.Arrow.ImageColor3 = DisplayColor
                Data.Arrow.Position = UDim2.new(0, ScreenCenter.X + math.sin(DirectionAngle) * Radius, 0, ScreenCenter.Y + math.cos(DirectionAngle) * Radius)
                Data.Arrow.Rotation = math.deg(DirectionAngle)
            else
                Data.Arrow.Visible = false
            end
        end
    end
end)

return Library
