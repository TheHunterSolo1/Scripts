function Library:AddESP(Cfg)
    if self.Unloaded then
        return
    end

    local Obj = Cfg and Cfg.Object

    if not Obj or self.Cache[Obj] then
        return
    end

    local Root = GetRoot(Obj)

    if not Root then
        task.spawn(function()
            local Attempts = 0

            while Obj.Parent and Attempts < 60 and not self.Unloaded do
                Root = GetRoot(Obj)

                if Root then
                    break
                end

                Attempts += 1
                task.wait(0.5)
            end

            if Root and Obj.Parent and not self.Cache[Obj] and not self.Unloaded then
                self:AddESP(Cfg)
            end
        end)

        return
    end

    local InitialColor = Cfg.Color or Color3.new(1, 1, 1)
    local InitialText = Cfg.Text or "ESP"

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = HttpService:GenerateGUID(false)
    Billboard.Size = UDim2.new(0, 250, 0, 60)
    Billboard.AlwaysOnTop = true
    Billboard.Adornee = Root
    Billboard.MaxDistance = self.Settings.MaxDistance
    Billboard.Parent = Obj

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.TextColor3 = InitialColor
    Label.Font = self.Settings.Font
    Label.TextSize = self.Settings.TextSize
    Label.TextStrokeTransparency = 0
    Label.TextTransparency = 1
    Label.Text = InitialText
    Label.Parent = Billboard

    local Line = Instance.new("Frame")
    Line.AnchorPoint = Vector2.new(0.5, 0.5)
    Line.BorderSizePixel = 0
    Line.BackgroundColor3 = InitialColor
    Line.Visible = true
    Line.BackgroundTransparency = 1
    Line.Parent = Screen

    local Arrow = Instance.new("ImageLabel")
    Arrow.BackgroundTransparency = 1
    Arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    Arrow.Size = UDim2.new(0, 32, 0, 32)
    Arrow.Image = "rbxassetid://10526559647"
    Arrow.ImageColor3 = InitialColor
    Arrow.Visible = false
    Arrow.Parent = Screen

    local Data = {
        Object = Obj,

        Tag = Billboard,
        Text = Label,
        Line = Line,
        Box = nil,
        Arrow = Arrow,

        Name = InitialText,
        Color = InitialColor,
        Root = Root,

        OwnsHighlight = false,
        HighlightInstance = nil,
        OriginalHighlight = nil,

        NextUpdate = 0,
        NextMetadataUpdate = 0,

        LastPosition = Root.Position,
        LastDistance = -1,
        LastDisplayedDistance = -1,

        LastTextColor = InitialColor,
        LastHighlightColor = InitialColor,
        LastLineColor = InitialColor,
        LastArrowColor = InitialColor,

        LastTextSize = self.Settings.TextSize,

        LastTagEnabled = true,
        LastTextVisible = false,
        LastBoxEnabled = false,
        LastLineVisible = true,
        LastArrowVisible = false,

        LastTracerX = -1,
        LastTracerY = -1,
        LastTracerLength = -1,
        LastTracerRotation = -999,

        LastArrowX = -1,
        LastArrowY = -1,
        LastArrowRotation = -999,

        LODLevel = -1,
        ScheduleVersion = 0,
        FadeToken = 0,
    }

    self.Cache[Obj] = Data
    self.ESPCount += 1

    local Highlight = FindHighlight(Obj)

    if Highlight then
        Data.Box = Highlight
        Data.HighlightInstance = Highlight
        Data.OwnsHighlight = false
        Data.OriginalHighlight = SaveHighlightState(Highlight)

        Highlight.Adornee = Obj
        Highlight.FillColor = InitialColor
        Highlight.FillTransparency = 1
        Highlight.OutlineTransparency = 1
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        Data.LastHighlightColor = InitialColor
        Data.LastBoxEnabled = Highlight.Enabled
    end

    local FT = self.Settings.FadeTime

    if FT > 0 then
        TweenService:Create(
            Label,
            self.TweenInfoFadeIn,
            {TextTransparency = 0}
        ):Play()

        if Highlight then
            TweenService:Create(
                Highlight,
                self.TweenInfoFadeIn,
                {FillTransparency = 0.6}
            ):Play()
        end

        TweenService:Create(
            Line,
            self.TweenInfoFadeIn,
            {BackgroundTransparency = 0}
        ):Play()
    else
        Label.TextTransparency = 0

        if Highlight then
            Highlight.FillTransparency = 0.6
        end

        Line.BackgroundTransparency = 0
    end

    local Now = os.clock()

    Data.NextMetadataUpdate = Now
    ScheduleObject(Data, Now)
end

function Library:RemoveESP(Obj)
    local Data = self.Cache[Obj]

    if not Data then
        return
    end

    self.Cache[Obj] = nil
    self.ESPCount = math.max(self.ESPCount - 1, 0)

    Data.ScheduleVersion += 1
    Data.FadeToken += 1

    local Token = Data.FadeToken
    local FT = math.max(self.Settings.FadeTime, 0)

    if FT > 0 then
        if Data.Text and Data.Text.Parent then
            TweenService:Create(
                Data.Text,
                self.TweenInfoFadeOut,
                {TextTransparency = 1}
            ):Play()
        end

        if Data.Box and Data.Box.Parent then
            TweenService:Create(
                Data.Box,
                self.TweenInfoFadeOut,
                {FillTransparency = 1}
            ):Play()
        end

        if Data.Line and Data.Line.Parent then
            TweenService:Create(
                Data.Line,
                self.TweenInfoFadeOut,
                {BackgroundTransparency = 1}
            ):Play()
        end

        task.delay(FT, function()
            if Data.FadeToken ~= Token then
                return
            end

            if Data.OwnsHighlight then
                if Data.Box and Data.Box.Parent then
                    Data.Box:Destroy()
                end
            else
                RestoreHighlight(Data)
            end

            if Data.Tag and Data.Tag.Parent then
                Data.Tag:Destroy()
            end

            if Data.Line and Data.Line.Parent then
                Data.Line:Destroy()
            end

            if Data.Arrow and Data.Arrow.Parent then
                Data.Arrow:Destroy()
            end

            Data.Box = nil
            Data.HighlightInstance = nil
            Data.OriginalHighlight = nil
        end)
    else
        if Data.OwnsHighlight then
            if Data.Box and Data.Box.Parent then
                Data.Box:Destroy()
            end
        else
            RestoreHighlight(Data)
        end

        if Data.Tag and Data.Tag.Parent then
            Data.Tag:Destroy()
        end

        if Data.Line and Data.Line.Parent then
            Data.Line:Destroy()
        end

        if Data.Arrow and Data.Arrow.Parent then
            Data.Arrow:Destroy()
        end

        Data.Box = nil
        Data.HighlightInstance = nil
        Data.OriginalHighlight = nil
    end
end

function Library:UpdateESP(Obj, NewText, NewColor)
    local Data = self.Cache[Obj]

    if Data then
        if NewText and Data.Name ~= NewText then
            Data.Name = NewText
            Data.Text.Text = NewText
            Data.LastDisplayedDistance = -1
            Data.NextMetadataUpdate = 0
        end

        if NewColor and Data.Color ~= NewColor then
            Data.Color = NewColor

            if Data.Text then
                Data.Text.TextColor3 = NewColor
            end

            if Data.Box and Data.Box.Parent then
                Data.Box.FillColor = NewColor
            end

            if Data.Line then
                Data.Line.BackgroundColor3 = NewColor
            end

            if Data.Arrow then
                Data.Arrow.ImageColor3 = NewColor
            end

            Data.LastTextColor = NewColor
            Data.LastHighlightColor = NewColor
            Data.LastLineColor = NewColor
            Data.LastArrowColor = NewColor
        end

        ScheduleObject(Data, os.clock())
    else
        self:AddESP({
            Object = Obj,
            Text = NewText or "ESP",
            Color = NewColor or Color3.new(1, 1, 1),
        })
    end
end

function Library:BulkUpdateESP(UpdateTable)
    local Now = os.clock()

    for Obj, Info in pairs(UpdateTable) do
        local Data = self.Cache[Obj]

        if Data then
            if Info.Text and Data.Name ~= Info.Text then
                Data.Name = Info.Text
                Data.Text.Text = Info.Text
                Data.LastDisplayedDistance = -1
                Data.NextMetadataUpdate = 0
            end

            if Info.Color and Data.Color ~= Info.Color then
                local Color = Info.Color

                Data.Color = Color

                if Data.Text then
                    Data.Text.TextColor3 = Color
                end

                if Data.Box and Data.Box.Parent then
                    Data.Box.FillColor = Color
                end

                if Data.Line then
                    Data.Line.BackgroundColor3 = Color
                end

                if Data.Arrow then
                    Data.Arrow.ImageColor3 = Color
                end

                Data.LastTextColor = Color
                Data.LastHighlightColor = Color
                Data.LastLineColor = Color
                Data.LastArrowColor = Color
            end

            ScheduleObject(Data, Now)
        elseif Info.Text and Info.Color then
            self:AddESP({
                Object = Obj,
                Text = Info.Text,
                Color = Info.Color,
            })
        end
    end
end

function Library:ClearAllESP()
    local Objects = {}

    for Obj in pairs(self.Cache) do
        Objects[#Objects + 1] = Obj
    end

    for i = 1, #Objects do
        self:RemoveESP(Objects[i])
    end
end

function Library:Unload()
    if self.Unloaded then
        return
    end

    self.Unloaded = true

    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end

    self.Scheduler = {}
    self.SchedulerSize = 0
    self.SchedulerEpoch += 1

    for Obj, Data in pairs(self.Cache) do
        self.Cache[Obj] = nil

        Data.FadeToken += 1

        if Data.OwnsHighlight then
            if Data.Box and Data.Box.Parent then
                Data.Box:Destroy()
            end
        else
            RestoreHighlight(Data)
        end

        if Data.Tag and Data.Tag.Parent then
            Data.Tag:Destroy()
        end

        if Data.Line and Data.Line.Parent then
            Data.Line:Destroy()
        end

        if Data.Arrow and Data.Arrow.Parent then
            Data.Arrow:Destroy()
        end
    end

    self.ESPCount = 0

    if Screen and Screen.Parent then
        Screen:Destroy()
    end
end

Camera = workspace.CurrentCamera

if Camera then
    local ViewportSize = Camera.ViewportSize

    Library.LastCamera = Camera
    Library.LastViewportX = ViewportSize.X
    Library.LastViewportY = ViewportSize.Y
    Library.LastFOV = Camera.FieldOfView
end

local ScreenCenter = Camera and Camera.ViewportSize / 2 or Vector2.zero
local ViewportSize = Camera and Camera.ViewportSize or Vector2.zero
local FOVScale = Camera and Camera.FieldOfView / 70 or 1

local LastHeartbeat = os.clock()

Library.Connection = RS.Heartbeat:Connect(function()
    if Library.Unloaded then
        return
    end

    local Now = os.clock()
    local Settings = Library.Settings

    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local CurrentViewport = Camera.ViewportSize
    local CurrentFOV = Camera.FieldOfView

    local CameraChanged =
        Camera ~= Library.LastCamera

    local ViewportChanged =
        CurrentViewport.X ~= Library.LastViewportX
        or CurrentViewport.Y ~= Library.LastViewportY

    local FOVChanged =
        CurrentFOV ~= Library.LastFOV

    if CameraChanged or ViewportChanged or FOVChanged then
        Library.LastCamera = Camera
        Library.LastViewportX = CurrentViewport.X
        Library.LastViewportY = CurrentViewport.Y
        Library.LastFOV = CurrentFOV

        ViewportSize = CurrentViewport
        ScreenCenter = CurrentViewport / 2
        FOVScale = CurrentFOV / 70

        InvalidateScheduler()
    end

    local RainbowInterval =
        1 / math.max(Settings.RainbowRate, 1)

    if Now - Library.LastRainbow >= RainbowInterval then
        Library.LastRainbow = Now
        Library.RainbowColor =
            Color3.fromHSV((Now % 5) / 5, 1, 1)
    end

    if Now - Library.LastCleanup >= Settings.CleanupInterval then
        Library.LastCleanup = Now

        for Object, Data in pairs(Library.Cache) do
            if not Object or not Object.Parent then
                Library:RemoveESP(Object)
                continue
            end

            if not Data.Root or not Data.Root.Parent then
                Data.Root = GetRoot(Object)
            end

            local CurrentHighlight = Data.Box

            if CurrentHighlight and not CurrentHighlight.Parent then
                Data.Box = nil
                Data.HighlightInstance = nil
                Data.OriginalHighlight = nil
                Data.OwnsHighlight = false
                Data.LastBoxEnabled = false
            end

            if not Data.Box then
                local Existing = FindHighlight(Object)

                if Existing then
                    Data.Box = Existing
                    Data.HighlightInstance = Existing
                    Data.OwnsHighlight = false
                    Data.OriginalHighlight = SaveHighlightState(Existing)

                    Existing.Adornee = Object
                    Existing.FillColor = Data.Color
                    Existing.FillTransparency = 1
                    Existing.OutlineTransparency = 1
                    Existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                    Data.LastHighlightColor = Data.Color
                    Data.LastBoxEnabled = Existing.Enabled
                end
            end
        end
    end

    local RenderInterval =
        1 / math.max(Settings.RenderTime, 1)

    if Now - LastHeartbeat < RenderInterval then
        return
    end

    LastHeartbeat = Now

    local Processed = 0
    local Budget = math.max(Settings.FrameBudget, 1)

    while Library.SchedulerSize > 0 and Processed < Budget do
        local Node

        Node, Library.SchedulerSize =
            HeapPop(
                Library.Scheduler,
                Library.SchedulerSize
            )

        if not Node then
            break
        end

        if Node.Epoch ~= Library.SchedulerEpoch then
            continue
        end

        if Node.Time > Now then
            Library.SchedulerSize =
                HeapPush(
                    Library.Scheduler,
                    Library.SchedulerSize,
                    Node
                )

            break
        end

        local Object = Node.Object
        local Data = Library.Cache[Object]

        if not Data then
            continue
        end

        if Data.ScheduleVersion ~= Node.Version then
            continue
        end

        Processed += 1

        if not Object.Parent then
            Library:RemoveESP(Object)
            continue
        end

        local RootPart = Data.Root

        if not RootPart or not RootPart.Parent then
            RootPart = GetRoot(Object)
            Data.Root = RootPart

            if not RootPart then
                ScheduleObject(Data, Now + 0.5)
                continue
            end
        end

        local Position = RootPart.Position
        local CameraCFrame = Camera.CFrame
        local CameraPosition = CameraCFrame.Position

        local DX = Position.X - CameraPosition.X
        local DY = Position.Y - CameraPosition.Y
        local DZ = Position.Z - CameraPosition.Z

        local DistanceSquared =
            DX * DX
            + DY * DY
            + DZ * DZ

        local MaxDistance = Settings.MaxDistance
        local MaxDistanceSquared =
            MaxDistance * MaxDistance

        if DistanceSquared > MaxDistanceSquared then
            SetVisible(
                Data,
                false,
                false,
                false,
                false,
                false
            )

            ScheduleObject(
                Data,
                Now + GetLODInterval(
                    DistanceSquared,
                    Settings.RenderTime,
                    Settings,
                    Library.ESPCount
                )
            )

            continue
        end

        local Distance =
            math.sqrt(DistanceSquared)

        local LastPosition =
            Data.LastPosition

        local MovementDX =
            Position.X - LastPosition.X

        local MovementDY =
            Position.Y - LastPosition.Y

        local MovementDZ =
            Position.Z - LastPosition.Z

        local MovementSquared =
            MovementDX * MovementDX
            + MovementDY * MovementDY
            + MovementDZ * MovementDZ

        Data.LastPosition = Position
        Data.LastDistance = Distance

        local Moving =
            MovementSquared > 0.0004

        if DistanceSquared <= 10000 then
            Data.LODLevel = 1
        elseif DistanceSquared <= 62500 then
            Data.LODLevel = 2
        elseif DistanceSquared <= 250000 then
            Data.LODLevel = 3
        elseif DistanceSquared <= 1000000 then
            Data.LODLevel = 4
        else
            Data.LODLevel = 5
        end

        local ScreenPosition, IsOnScreen =
            Camera:WorldToViewportPoint(Position)

        local DisplayColor =
            Settings.Rainbow
            and Library.RainbowColor
            or Data.Color

        if IsOnScreen then
            local ESPMode = Settings.ESPMode

            local ShowHighlight =
                ESPMode == "Highlight"
                or ESPMode == "Highlight/Text"

            local ShowText =
                ESPMode == "Text"
                or ESPMode == "Highlight/Text"

            if ShowHighlight then
                local Highlight =
                    EnsureHighlight(Data)

                if Highlight then
                    SetHighlightColor(
                        Data,
                        DisplayColor
                    )

                    if Data.LastBoxEnabled ~= true then
                        Highlight.Enabled = true
                        Data.LastBoxEnabled = true
                    end
                else
                    Data.LastBoxEnabled = false
                end
            end

            SetVisible(
                Data,
                true,
                ShowText,
                ShowHighlight and Data.Box ~= nil,
                Settings.Tracers and Distance < 1500,
                false
            )

            if ShowText then
                SetTextColor(
                    Data,
                    DisplayColor
                )

                local TextSize =
                    Settings.TextSize * FOVScale

                if Data.LastTextSize ~= TextSize then
                    Data.Text.TextSize = TextSize
                    Data.LastTextSize = TextSize
                end

                if Now >= Data.NextMetadataUpdate then
                    local DistanceFloor =
                        math.floor(Distance)

                    if Settings.Distance then
                        if Data.LastDisplayedDistance ~= DistanceFloor then
                            Data.Text.Text =
                                Data.Name
                                .. "\n["
                                .. DistanceFloor
                                .. "m]"

                            Data.LastDisplayedDistance =
                                DistanceFloor
                        end
                    elseif Data.LastDisplayedDistance ~= -2 then
                        Data.Text.Text = Data.Name
                        Data.LastDisplayedDistance = -2
                    end

                    Data.NextMetadataUpdate =
                        Now + Settings.MetadataInterval
                end
            end

            if Settings.Tracers and Distance < 1500 then
                SetLineColor(
                    Data,
                    DisplayColor
                )

                local SX = ScreenPosition.X
                local SY = ScreenPosition.Y

                local OriginX =
                    ScreenCenter.X

                local OriginY =
                    ViewportSize.Y

                local DifferenceX =
                    SX - OriginX

                local DifferenceY =
                    SY - OriginY

                local Length =
                    math.sqrt(
                        DifferenceX * DifferenceX
                        + DifferenceY * DifferenceY
                    )

                local Rotation =
                    math.deg(
                        math.atan2(
                            DifferenceY,
                            DifferenceX
                        )
                    )

                if
                    Data.LastTracerX ~= SX
                    or Data.LastTracerY ~= SY
                    or Data.LastTracerLength ~= Length
                    or Data.LastTracerRotation ~= Rotation
                then
                    Data.Line.Size =
                        UDim2.new(
                            0,
                            Length,
                            0,
                            1
                        )

                    Data.Line.Position =
                        UDim2.new(
                            0,
                            OriginX
                                + DifferenceX * 0.5,
                            0,
                            OriginY
                                + DifferenceY * 0.5
                        )

                    Data.Line.Rotation =
                        Rotation

                    Data.LastTracerX = SX
                    Data.LastTracerY = SY
                    Data.LastTracerLength = Length
                    Data.LastTracerRotation =
                        Rotation
                end
            end
        else
            SetVisible(
                Data,
                false,
                false,
                false,
                false,
                Settings.Arrows
            )

            if Settings.Arrows then
                SetArrowColor(
                    Data,
                    DisplayColor
                )

                local Relative =
                    CameraCFrame:PointToObjectSpace(
                        Position
                    )

                local DirectionAngle =
                    math.atan2(
                        -Relative.X,
                        -Relative.Z
                    )

                local Radius =
                    ViewportSize.Y * 0.4

                local ArrowX =
                    ScreenCenter.X
                    + math.sin(DirectionAngle)
                    * Radius

                local ArrowY =
                    ScreenCenter.Y
                    + math.cos(DirectionAngle)
                    * Radius

                local ArrowRotation =
                    math.deg(DirectionAngle)

                if
                    Data.LastArrowX ~= ArrowX
                    or Data.LastArrowY ~= ArrowY
                    or Data.LastArrowRotation ~= ArrowRotation
                then
                    Data.Arrow.Position =
                        UDim2.new(
                            0,
                            ArrowX,
                            0,
                            ArrowY
                        )

                    Data.Arrow.Rotation =
                        ArrowRotation

                    Data.LastArrowX = ArrowX
                    Data.LastArrowY = ArrowY
                    Data.LastArrowRotation =
                        ArrowRotation
                end
            end
        end

        local Interval =
            GetLODInterval(
                DistanceSquared,
                Settings.RenderTime,
                Settings,
                Library.ESPCount
            )

        if Settings.MovementPriority then
            if Moving then
                Interval *= 0.55
            else
                Interval *= 1.15
            end
        end

        ScheduleObject(
            Data,
            Now + math.max(
                Interval,
                1 / 60
            )
        )
    end
end)

return Library