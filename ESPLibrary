local function GetRoot(Obj)
    if not Obj then
        return nil
    end

    if Obj:IsA("Model") then
        return Obj:FindFirstChild("HumanoidRootPart")
            or Obj.PrimaryPart
            or Obj:FindFirstChildWhichIsA("BasePart")
    end

    if Obj:IsA("BasePart") then
        return Obj
    end

    return nil
end

local function FindHighlight(Obj)
    if not Obj then
        return nil
    end

    return Obj:FindFirstChildWhichIsA("Highlight", true)
end

local function SaveHighlightState(Highlight)
    if not Highlight then
        return nil
    end

    return {
        Enabled = Highlight.Enabled,
        Adornee = Highlight.Adornee,
        FillColor = Highlight.FillColor,
        FillTransparency = Highlight.FillTransparency,
        OutlineColor = Highlight.OutlineColor,
        OutlineTransparency = Highlight.OutlineTransparency,
        DepthMode = Highlight.DepthMode,
    }
end

local function RestoreHighlight(Data)
    local Highlight = Data.Box
    local Original = Data.OriginalHighlight

    if not Highlight or not Highlight.Parent or not Original then
        return
    end

    if Data.HighlightInstance ~= Highlight then
        return
    end

    Highlight.Enabled = Original.Enabled
    Highlight.Adornee = Original.Adornee
    Highlight.FillColor = Original.FillColor
    Highlight.FillTransparency = Original.FillTransparency
    Highlight.OutlineColor = Original.OutlineColor
    Highlight.OutlineTransparency = Original.OutlineTransparency
    Highlight.DepthMode = Original.DepthMode
end

local function CreateESPHighlight(Data)
    local Obj = Data.Object

    if not Obj or not Obj.Parent then
        return nil
    end

    local Existing = FindHighlight(Obj)

    if Existing then
        Data.Box = Existing
        Data.HighlightInstance = Existing
        Data.OwnsHighlight = false
        Data.OriginalHighlight = SaveHighlightState(Existing)

        Existing.Adornee = Obj
        Existing.FillColor = Data.Color
        Existing.FillTransparency = 1
        Existing.OutlineTransparency = 1
        Existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        Data.LastHighlightColor = Data.Color
        Data.LastBoxEnabled = Existing.Enabled

        return Existing
    end

    local Highlight = Instance.new("Highlight")

    Highlight.Adornee = Obj
    Highlight.FillColor = Data.Color
    Highlight.FillTransparency = 1
    Highlight.OutlineTransparency = 1
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Obj

    Data.Box = Highlight
    Data.HighlightInstance = Highlight
    Data.OwnsHighlight = true
    Data.OriginalHighlight = nil

    Data.LastHighlightColor = Data.Color
    Data.LastBoxEnabled = Highlight.Enabled

    return Highlight
end

local function EnsureHighlight(Data)
    local Obj = Data.Object
    local Current = Data.Box

    if Current and Current.Parent then
        return Current
    end

    local Existing = FindHighlight(Obj)

    if Existing then
        Data.Box = Existing
        Data.HighlightInstance = Existing
        Data.OwnsHighlight = false
        Data.OriginalHighlight = SaveHighlightState(Existing)

        Existing.Adornee = Obj
        Existing.FillColor = Data.Color
        Existing.FillTransparency = 1
        Existing.OutlineTransparency = 1
        Existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        Data.LastHighlightColor = Data.Color
        Data.LastBoxEnabled = Existing.Enabled

        return Existing
    end

    return CreateESPHighlight(Data)
end

local function ReleaseHighlight(Data)
    local Highlight = Data.Box

    if not Highlight then
        return
    end

    if Data.OwnsHighlight then
        if Highlight.Parent then
            Highlight:Destroy()
        end
    else
        RestoreHighlight(Data)
    end

    Data.Box = nil
    Data.HighlightInstance = nil
    Data.OriginalHighlight = nil
    Data.OwnsHighlight = false
    Data.LastBoxEnabled = false
end

local function HeapPush(Heap, Size, Node)
    Size += 1

    local Index = Size

    while Index > 1 do
        local Parent = math.floor(Index / 2)

        if Heap[Parent].Time <= Node.Time then
            break
        end

        Heap[Index] = Heap[Parent]
        Index = Parent
    end

    Heap[Index] = Node

    return Size
end

local function HeapPop(Heap, Size)
    if Size <= 0 then
        return nil, 0
    end

    local Root = Heap[1]
    local Last = Heap[Size]

    Heap[Size] = nil
    Size -= 1

    if Size <= 0 then
        return Root, 0
    end

    local Index = 1

    while true do
        local Left = Index * 2

        if Left > Size then
            break
        end

        local Right = Left + 1
        local Child = Left

        if Right <= Size and Heap[Right].Time < Heap[Left].Time then
            Child = Right
        end

        if Heap[Child].Time >= Last.Time then
            break
        end

        Heap[Index] = Heap[Child]
        Index = Child
    end

    Heap[Index] = Last

    return Root, Size
end

local function GetLODInterval(DistanceSquared, RenderTime, Settings, ESPCount)
    local SpeedMultiplier

    if DistanceSquared <= 10000 then
        SpeedMultiplier = Settings.LOD100
    elseif DistanceSquared <= 62500 then
        SpeedMultiplier = Settings.LOD250
    elseif DistanceSquared <= 250000 then
        SpeedMultiplier = Settings.LOD500
    elseif DistanceSquared <= 1000000 then
        SpeedMultiplier = Settings.LOD1000
    else
        SpeedMultiplier = Settings.LODFar
    end

    SpeedMultiplier = math.max(SpeedMultiplier, 0.01)

    if Settings.AdaptiveLOD then
        if ESPCount > 150 then
            SpeedMultiplier *= 0.45
        elseif ESPCount > 100 then
            SpeedMultiplier *= 0.6
        elseif ESPCount > 60 then
            SpeedMultiplier *= 0.8
        end
    end

    return math.max(
        1 / math.max(RenderTime, 1) / SpeedMultiplier,
        1 / 60
    )
end

local function SetVisible(Data, Tag, Text, Box, Line, Arrow)
    if Data.Tag and Data.LastTagEnabled ~= Tag then
        Data.Tag.Enabled = Tag
        Data.LastTagEnabled = Tag
    end

    if Data.Text and Data.LastTextVisible ~= Text then
        Data.Text.Visible = Text
        Data.LastTextVisible = Text
    end

    if Data.LastBoxEnabled ~= Box then
        local Highlight = Data.Box

        if Highlight and Highlight.Parent then
            Highlight.Enabled = Box
        end

        Data.LastBoxEnabled = Box
    end

    if Data.Line and Data.LastLineVisible ~= Line then
        Data.Line.Visible = Line
        Data.LastLineVisible = Line
    end

    if Data.Arrow and Data.LastArrowVisible ~= Arrow then
        Data.Arrow.Visible = Arrow
        Data.LastArrowVisible = Arrow
    end
end

local function SetTextColor(Data, Color)
    if Data.Text and Data.LastTextColor ~= Color then
        Data.Text.TextColor3 = Color
        Data.LastTextColor = Color
    end
end

local function SetHighlightColor(Data, Color)
    local Highlight = Data.Box

    if Highlight and Highlight.Parent and Data.LastHighlightColor ~= Color then
        Highlight.FillColor = Color
        Data.LastHighlightColor = Color
    end
end

local function SetLineColor(Data, Color)
    if Data.Line and Data.LastLineColor ~= Color then
