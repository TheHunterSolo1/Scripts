local UserInputService = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local Players = game:GetService("Players")

local Device = UserInputService.TouchEnabled and "Mobile" or "PC"
local UseDrawing = (typeof(Drawing) == "table" and type(Drawing.new) == "function")

local floor = math.floor
local atan2 = math.atan2
local deg = math.deg
local sin = math.sin
local cos = math.cos
local vector2New = Vector2.new
local tickFunc = tick
local pcallFunc = pcall
local tableClear = table.clear

local Library = {
    Settings = {
        Tracers = true,
        Distance = true,
        Arrows = true,
        Rainbow = false,
        MaxDistance = 999999,
        TextSize = 25,
        Font = 2,
        FadeTime = 0.7,
        ESPMode = "Highlight/Text",
        RenderTime = Device == "PC" and 240 or 60,
    },
    Cache = {},
    ActiveDelays = {},
}

local idCounter = 0
local function GetUniqueId()
    idCounter = idCounter + 1
    return "ESP_" .. tostring(idCounter)
end

local function GetRoot(Obj)
    if not Obj then return nil end
    if Obj:IsA("Model") then
        return Obj.PrimaryPart or Obj:FindFirstChild("HumanoidRootPart") or Obj:FindFirstChildWhichIsA("BasePart")
    end
    if Obj:IsA("BasePart") then
        return Obj
    end
    return nil
end

function Library:SetFont(Font) self.Settings.Font = Font end
function Library:SetRainbow(Bool) self.Settings.Rainbow = Bool end
function Library:SetFadeTime(Value) self.Settings.FadeTime = Value end
function Library:SetArrows(Bool) self.Settings.Arrows = Bool end
function Library:SetTracers(Bool) self.Settings.Tracers = Bool end
function Library:SetShowDistance(Bool) self.Settings.Distance = Bool end
function Library:SetESPMode(Value) self.Settings.ESPMode = Value end
function Library:SetRenderingSpeed(Value) self.Settings.RenderTime = Value end

function Library:HasESP(Obj) return self.Cache[Obj] ~= nil end
function Library:GetESPData(Obj) return self.Cache[Obj] end

function Library:GetAllESP()
    local Result = {}
    for Obj, Data in pairs(self.Cache) do
        Result[Obj] = { Name = Data.Name, Color = Data.Color, Root = Data.Root }
    end
    return Result
end

function Library:CountESP()
    local Count = 0
    for _ in pairs(self.Cache) do Count = Count + 1 end
    return Count
end

function Library:AddESP(Cfg)
    local Obj = Cfg.Object
    if not Obj or self.Cache[Obj] then return end

    local Root = GetRoot(Obj)
    if not Root then
        task.spawn(function()
            local Attempts = 0
            while not Root and Attempts < 60 and Obj.Parent do
                Root = GetRoot(Obj)
                Attempts = Attempts + 1
                task.wait(0.5)
            end
            if Root and Obj.Parent then
                self:AddESP(Cfg)
            end
        end)
        return
    end

    local ElementContainer = {}

    if UseDrawing then
        local TextObj = Drawing.new("Text")
        TextObj.Visible = false
        TextObj.Center = true
        TextObj.Outline = true
        TextObj.Font = self.Settings.Font
        TextObj.Size = self.Settings.TextSize
        TextObj.Color = Cfg.Color
        TextObj.Text = Cfg.Text

        local TracerObj = Drawing.new("Line")
        TracerObj.Visible = false
        TracerObj.Thickness = 1
        TracerObj.Color = Cfg.Color

        local ArrowObj = Drawing.new("Triangle")
        ArrowObj.Visible = false
        ArrowObj.Filled = true
        ArrowObj.Color = Cfg.Color

        local BoxObj = Drawing.new("Square")
        BoxObj.Visible = false
        BoxObj.Thickness = 1
        BoxObj.Filled = false
        BoxObj.Color = Cfg.Color

        ElementContainer = {
            Text = TextObj,
            Tracer = TracerObj,
            Arrow = ArrowObj,
            Box = BoxObj,
            IsDrawing = true
        }
    else
        local CoreGui = gethui and gethui() or game:GetService("CoreGui")
        local Screen = Instance.new("ScreenGui")
        Screen.Name = GetUniqueId()
        Screen.IgnoreGuiInset = true
        Screen.Parent = CoreGui

        local Label = Instance.new("TextLabel")
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(0, 250, 0, 50)
        Label.AnchorPoint = vector2New(0.5, 0.5)
        Label.TextColor3 = Cfg.Color
        Label.TextSize = self.Settings.TextSize
        Label.TextStrokeTransparency = 0
        Label.Text = Cfg.Text
        Label.Parent = Screen

        local Line = Instance.new("Frame")
        Line.AnchorPoint = vector2New(0.5, 0.5)
        Line.BorderSizePixel = 0
        Line.BackgroundColor3 = Cfg.Color
        Line.Visible = false
        Line.Parent = Screen

        ElementContainer = {
            Gui = Screen,
            Text = Label,
            Line = Line,
            IsDrawing = false
        }
    end

    self.Cache[Obj] = {
        Container = ElementContainer,
        Name = Cfg.Text,
        Color = Cfg.Color,
        Root = Root,
        CacheState = {}
    }
end

function Library:RemoveESP(Obj)
    local Data = self.Cache[Obj]
    if not Data then return end
    self.Cache[Obj] = nil

    pcallFunc(function()
        if Data.Container.IsDrawing then
            for _, obj in pairs(Data.Container) do
                if typeof(obj) == "userdata" and type(obj.Remove) == "function" then
                    obj:Remove()
                end
            end
        else
            Data.Container.Gui:Destroy()
        end
    end)
end

function Library:UpdateESP(Obj, NewText, NewColor)
    local Data = self.Cache[Obj]
    if Data then
        if NewText and Data.Name ~= NewText then
            Data.Name = NewText
            if Data.Container.IsDrawing then
                Data.Container.Text.Text = NewText
            else
                Data.Container.Text.Text = NewText
            end
        end
        if NewColor and Data.Color ~= NewColor then
            Data.Color = NewColor
            if Data.Container.IsDrawing then
                Data.Container.Text.Color = NewColor
                Data.Container.Tracer.Color = NewColor
                Data.Container.Arrow.Color = NewColor
                Data.Container.Box.Color = NewColor
            else
                Data.Container.Text.TextColor3 = NewColor
                Data.Container.Line.BackgroundColor3 = NewColor
            end
        end
    else
        self:AddESP({Object = Obj, Text = NewText or "ESP", Color = NewColor or Color3.new(1, 1, 1)})
    end
end

function Library:BulkUpdateESP(UpdateTable)
    for Obj, Info in pairs(UpdateTable) do
        self:UpdateESP(Obj, Info.Text, Info.Color)
    end
end

function Library:ClearAllESP()
    for Obj in pairs(self.Cache) do
        self:RemoveESP(Obj)
    end
end

function Library:Unload()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
    tableClear(self.ActiveDelays)
    for Obj in pairs(self.Cache) do
        self:RemoveESP(Obj)
    end
end

local LastUpdateTick = tickFunc()

Library.Connection = RS.Heartbeat:Connect(function()
    local nextTick = tickFunc()
    local RenderInterval = 1 / Library.Settings.RenderTime
    if nextTick - LastUpdateTick < RenderInterval then return end
    LastUpdateTick = nextTick

    local Camera = workspace.CurrentCamera
    if not Camera then return end
    
    local Count = 0
    for _ in pairs(Library.Cache) do Count = Count + 1 break end
    if Count == 0 then return end

    local CameraCFrame = Camera.CFrame
    local CameraPos = CameraCFrame.Position
    local ViewportSize = Camera.ViewportSize
    local ScreenCenter = ViewportSize / 2
    local RainbowColor = Color3.fromHSV(nextTick % 5 / 5, 1, 1)

    for Object, Data in pairs(Library.Cache) do
        if not Object or not Object.Parent then
            Library:RemoveESP(Object)
            continue
        end

        local RootPart = Data.Root
        if not RootPart or not RootPart.Parent then
            Data.Root = GetRoot(Object)
            RootPart = Data.Root
            if not RootPart then continue end
        end

        local RootPos = RootPart.Position
        local CalculatedDistance = (CameraPos - RootPos).Magnitude
        local State = Data.CacheState
        local DisplayColor = Library.Settings.Rainbow and RainbowColor or Data.Color
        local ScreenPosition, IsOnScreen = Camera:WorldToViewportPoint(RootPos)

        if CalculatedDistance > Library.Settings.MaxDistance then
            if State.MaxDist ~= true then
                State.MaxDist = true
                if Data.Container.IsDrawing then
                    Data.Container.Text.Visible = false
                    Data.Container.Tracer.Visible = false
                    Data.Container.Arrow.Visible = false
                    Data.Container.Box.Visible = false
                else
                    Data.Container.Text.Visible = false
                    Data.Container.Line.Visible = false
                end
            end
            continue
        end
        State.MaxDist = false

        if Data.Container.IsDrawing then
            local C = Data.Container
            if IsOnScreen then
                C.Arrow.Visible = false
                local ESPMode = Library.Settings.ESPMode
                local ShowText = ESPMode == "Text" or ESPMode == "Highlight/Text"

                if ShowText then
                    C.Text.Visible = true
                    C.Text.Color = DisplayColor
                    C.Text.Size = Library.Settings.TextSize
                    C.Text.Position = vector2New(ScreenPosition.X, ScreenPosition.Y - 20)
                    local DistanceStr = Library.Settings.Distance and string.format("\n[%dm]", floor(CalculatedDistance)) or ""
                    C.Text.Text = Data.Name .. DistanceStr
                else
                    C.Text.Visible = false
                end

                if Library.Settings.Tracers and CalculatedDistance < 1500 then
                    C.Tracer.Visible = true
                    C.Tracer.Color = DisplayColor
                    C.Tracer.From = vector2New(ScreenCenter.X, ViewportSize.Y)
                    C.Tracer.To = vector2New(ScreenPosition.X, ScreenPosition.Y)
                else
                    C.Tracer.Visible = false
                end
                C.Box.Visible = false
            else
                C.Text.Visible = false
                C.Tracer.Visible = false
                C.Box.Visible = false

                if Library.Settings.Arrows then
                    C.Arrow.Visible = true
                    C.Arrow.Color = DisplayColor
                    local ObjectRelativeSpace = CameraCFrame:PointToObjectSpace(RootPos)
                    local DirectionAngle = atan2(-ObjectRelativeSpace.X, -ObjectRelativeSpace.Z)
                    local Radius = ViewportSize.Y * 0.4
                    local ArrowPos = vector2New(ScreenCenter.X + sin(DirectionAngle) * Radius, ScreenCenter.Y + cos(DirectionAngle) * Radius)
                    C.Arrow.PointA = ArrowPos + vector2New(0, -10)
                    C.Arrow.PointB = ArrowPos + vector2New(-6, 8)
                    C.Arrow.PointC = ArrowPos + vector2New(6, 8)
                else
                    C.Arrow.Visible = false
                end
            end
        else
            local C = Data.Container
            if IsOnScreen then
                C.Text.Visible = true
                C.Text.TextColor3 = DisplayColor
                C.Text.Position = UDim2.new(0, ScreenPosition.X, 0, ScreenPosition.Y - 20)
                local DistanceStr = Library.Settings.Distance and string.format("\n[%dm]", floor(CalculatedDistance)) or ""
                C.Text.Text = Data.Name .. DistanceStr

                if Library.Settings.Tracers and CalculatedDistance < 1500 then
                    local ScreenPoint = vector2New(ScreenPosition.X, ScreenPosition.Y)
                    local OriginPoint = vector2New(ScreenCenter.X, ViewportSize.Y)
                    local VectorDifference = ScreenPoint - OriginPoint
                    C.Line.Visible = true
                    C.Line.BackgroundColor3 = DisplayColor
                    C.Line.Size = UDim2.new(0, VectorDifference.Magnitude, 0, 1)
                    C.Line.Position = UDim2.new(0, OriginPoint.X + VectorDifference.X / 2, 0, OriginPoint.Y + VectorDifference.Y / 2)
                    C.Line.Rotation = deg(atan2(VectorDifference.Y, VectorDifference.X))
                else
                    C.Line.Visible = false
                end
            else
                C.Text.Visible = false
                C.Line.Visible = false
            end
        end
    end
end)

return Library
